---
import { contacts } from '../data/navigation';
const whatsappHref = 'https://wa.me/79863458235';
---

<details class="call-widget" data-call-widget>
  <summary aria-label="Открыть способы связи" aria-haspopup="menu">
    <span class="call-widget__phone" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M7.2 3.8 5.7 5.1c-.8.7-.9 1.9-.4 2.8 2.2 4 5.1 6.9 9.1 9.1.9.5 2.1.4 2.8-.4l1.3-1.5c.4-.5.4-1.2-.1-1.6l-2.5-1.8c-.4-.3-1-.3-1.4 0l-1.2.9a12.7 12.7 0 0 1-2.9-2.9l.9-1.2c.3-.4.3-1 0-1.4L8.8 3.9c-.4-.5-1.1-.5-1.6-.1Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/></svg></span>
    <span class="call-widget__close" aria-hidden="true"></span>
  </summary>
  <nav class="call-widget__petals" aria-label="Способы связи">
    <a class="call-widget__petal call-widget__petal--phone" href={contacts.phoneHref} aria-label={`Позвонить ${contacts.phone}`} title="Позвонить"><svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M7.2 3.8 5.7 5.1c-.8.7-.9 1.9-.4 2.8 2.2 4 5.1 6.9 9.1 9.1.9.5 2.1.4 2.8-.4l1.3-1.5c.4-.5.4-1.2-.1-1.6l-2.5-1.8c-.4-.3-1-.3-1.4 0l-1.2.9a12.7 12.7 0 0 1-2.9-2.9l.9-1.2c.3-.4.3-1 0-1.4L8.8 3.9c-.4-.5-1.1-.5-1.6-.1Z" stroke="currentColor" stroke-width="1.9" stroke-linejoin="round"/></svg></a>
    <a class="call-widget__petal call-widget__petal--telegram" href={contacts.telegramHref} target="_blank" rel="noopener noreferrer" aria-label="Написать в Telegram" title="Telegram"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m21.4 4.2-3 14.3c-.2 1-.8 1.3-1.6.8l-4.4-3.2-2.1 2c-.2.2-.4.4-.8.4l.3-4.5 8.2-7.4c.4-.4-.1-.6-.6-.2L7.3 12l-4.3-1.4c-.9-.3-.9-.9.2-1.3L20 3.4c.8-.3 1.6.2 1.4.8Z"/></svg></a>
    <a class="call-widget__petal call-widget__petal--whatsapp" href={whatsappHref} target="_blank" rel="noopener noreferrer" aria-label={`Написать в WhatsApp ${contacts.phone}`} title="WhatsApp"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2a9.8 9.8 0 0 0-8.46 14.75L2.2 21.8l5.17-1.35A9.83 9.83 0 1 0 12.04 2Zm0 17.86a8 8 0 0 1-4.1-1.12l-.3-.18-3.07.8.82-2.99-.2-.3a8.03 8.03 0 1 1 6.85 3.79Zm4.4-6.02c-.24-.12-1.43-.7-1.65-.78-.22-.08-.38-.12-.54.12-.16.24-.62.78-.76.94-.14.16-.28.18-.52.06-.24-.12-1.02-.38-1.94-1.2a7.25 7.25 0 0 1-1.34-1.66c-.14-.24-.02-.37.1-.49.11-.1.24-.28.36-.42.12-.14.16-.24.24-.4.08-.16.04-.3-.02-.42-.06-.12-.54-1.3-.74-1.78-.2-.47-.4-.4-.54-.41h-.46c-.16 0-.42.06-.64.3-.22.24-.84.82-.84 2s.86 2.32.98 2.48c.12.16 1.7 2.6 4.12 3.64.58.25 1.03.4 1.38.51.58.18 1.1.16 1.52.1.46-.07 1.43-.59 1.63-1.15.2-.56.2-1.04.14-1.14-.06-.1-.22-.16-.46-.28Z"/></svg></a>
  </nav>
</details>

<script>
  document.querySelectorAll<HTMLDetailsElement>('[data-call-widget]').forEach((widget) => {
    const summary = widget.querySelector('summary');
    widget.addEventListener('toggle', () => summary?.setAttribute('aria-label', widget.open ? 'Закрыть способы связи' : 'Открыть способы связи'));
    document.addEventListener('pointerdown', (event) => {
      if (widget.open && event.target instanceof Node && !widget.contains(event.target)) widget.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && widget.open) { widget.open = false; summary?.focus(); }
    });
  });
</script>

<style>
  .call-widget { --widget-size: 68px; --petal-size: 55px; position: fixed; right: 22px; bottom: 22px; z-index: 1200; width: var(--widget-size); height: var(--widget-size); color: #fff; font-family: Manrope, Arial, sans-serif; }
  .call-widget summary { position: relative; z-index: 4; display: grid; width: var(--widget-size); height: var(--widget-size); box-sizing: border-box; place-items: center; border: 3px solid #fff; border-radius: 50%; background: #9b0010; box-shadow: 0 0 0 4px #b89954, 0 11px 30px rgba(39,0,4,.38); cursor: pointer; list-style: none; transition: transform .24s ease, box-shadow .24s ease, background-color .24s ease; }
  .call-widget summary::-webkit-details-marker { display: none; }
  .call-widget summary::marker { content: ''; font-size: 0; }
  .call-widget summary:hover { background: #b00a19; transform: scale(1.04); }
  .call-widget summary:focus-visible { outline: 3px solid #f5c36b; outline-offset: 6px; }
  .call-widget__phone, .call-widget__close { position: absolute; display: grid; width: 32px; height: 32px; place-items: center; transition: opacity .2s ease, transform .25s ease; }
  .call-widget__phone { animation: call-ring 2.6s ease-in-out infinite; }
  .call-widget__phone svg { width: 32px; height: 32px; }
  .call-widget__close { opacity: 0; transform: rotate(-45deg) scale(.6); }
  .call-widget__close::before, .call-widget__close::after { content: ''; position: absolute; width: 29px; height: 3px; border-radius: 4px; background: #fff; }
  .call-widget__close::after { transform: rotate(90deg); }
  .call-widget[open] .call-widget__phone { opacity: 0; animation: none; transform: rotate(45deg) scale(.55); }
  .call-widget[open] .call-widget__close { opacity: 1; transform: rotate(45deg) scale(1); }
  .call-widget__petals { position: absolute; inset: 0; z-index: 2; }
  .call-widget__petal { position: absolute; right: calc((var(--widget-size) - var(--petal-size))/2); bottom: calc((var(--widget-size) - var(--petal-size))/2); display: grid; width: var(--petal-size); height: var(--petal-size); box-sizing: border-box; place-items: center; border: 2px solid rgba(255,255,255,.94); border-radius: 50%; color: #fff; box-shadow: 0 8px 24px rgba(17,10,10,.28); opacity: 0; pointer-events: none; transform: translate(0,0) scale(.45); transition: opacity .18s ease, transform .32s cubic-bezier(.2,.8,.2,1), filter .2s ease; }
  .call-widget__petal svg { width: 27px; height: 27px; }
  .call-widget__petal:hover { filter: brightness(1.1); }
  .call-widget__petal:focus-visible { outline: 3px solid #f5c36b; outline-offset: 3px; }
  .call-widget__petal--phone { background: #9b0010; }
  .call-widget__petal--telegram { background: #229ed9; transition-delay: .035s; }
  .call-widget__petal--whatsapp { background: #25d366; transition-delay: .07s; }
  .call-widget[open] .call-widget__petal { opacity: 1; pointer-events: auto; }
  .call-widget[open] .call-widget__petal--phone { transform: translate(-93px,4px) scale(1); }
  .call-widget[open] .call-widget__petal--telegram { transform: translate(-72px,-72px) scale(1); }
  .call-widget[open] .call-widget__petal--whatsapp { transform: translate(4px,-93px) scale(1); }
  @keyframes call-ring { 0%,65%,100% { transform: rotate(0); } 8%,18%,28% { transform: rotate(-12deg); } 13%,23%,33% { transform: rotate(12deg); } 40% { transform: rotate(0); } }
  @media (max-width:720px) { .call-widget { --widget-size:60px; --petal-size:50px; right:15px; bottom:16px; } .call-widget__phone, .call-widget__phone svg { width:29px; height:29px; } .call-widget__petal svg { width:24px; height:24px; } .call-widget[open] .call-widget__petal--phone { transform:translate(-82px,3px) scale(1); } .call-widget[open] .call-widget__petal--telegram { transform:translate(-64px,-64px) scale(1); } .call-widget[open] .call-widget__petal--whatsapp { transform:translate(3px,-82px) scale(1); } }
  @media (prefers-reduced-motion:reduce) { .call-widget__phone { animation:none; } .call-widget summary, .call-widget__phone, .call-widget__close, .call-widget__petal { transition:none; } }
</style>
