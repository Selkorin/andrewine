---
import cellarImage from '../assets/article-backgrounds/cellar-racks.webp';

const { root = './' } = Astro.props;

const drinks = [
  { value: 'Текила', image: '/assets/tequila-bottle-cutout.png' },
  { value: 'Водка', image: '/vendor/tilda/static.tildacdn.com/tild3035-3566-4032-b235-353665353831/_1.webp' },
  { value: 'Виски', image: '/vendor/tilda/static.tildacdn.com/tild3461-3761-4065-b330-633464613932/__1.webp' },
  { value: 'Коньяк', image: '/vendor/tilda/static.tildacdn.com/tild6339-6161-4239-b832-383733303766/2_1.webp' },
  { value: 'Арманьяк', image: '/vendor/tilda/static.tildacdn.com/tild3264-3533-4361-a466-616537623862/kkk_1.webp' },
  { value: 'Вино', image: '/vendor/tilda/static.tildacdn.com/tild3231-3134-4737-a235-653231313864/ChatGPT_Image_21__20.webp' },
  { value: 'Ром', image: '/vendor/tilda/static.tildacdn.com/tild6663-3730-4338-b133-623764313262/diplomatiko_1.webp' },
];
---

<section class="valuation-quiz" id="online-valuation" aria-labelledby="valuation-quiz-title" style={`--cellar-image:url(${cellarImage.src})`}>
  <div class="valuation-quiz__magnifier" aria-hidden="true"></div>
  <div class="valuation-quiz__intro">
    <p class="valuation-quiz__eyebrow">Онлайн-оценка</p>
    <h2 id="valuation-quiz-title">Узнайте стоимость вашей бутылки</h2>
    <p>Ответьте на несколько вопросов и прикрепите фотографии. Эндрю изучит бутылку, рассчитает её стоимость и отправит предложение в Telegram или WhatsApp.</p>
    <p class="valuation-quiz__promise">Для редких позиций предлагаем цену выше средней по рынку — после проверки состояния и подлинности.</p>
    <div class="valuation-quiz__facts" aria-label="Преимущества оценки">
      <span><b>≈ 1 минута</b> на заполнение</span>
      <span><b>До 10 фото</b> в одной заявке</span>
    </div>
    <div class="valuation-quiz__andrew" aria-hidden="true">
      <img src="/assets/andrew-quiz.png" alt="" />
      <span><b>Эндрю на связи</b><small>Лично проверю вашу заявку</small></span>
    </div>
  </div>

  <form class="valuation-quiz__card" data-valuation-quiz novalidate>
    <div class="valuation-quiz__topline">
      <span class="valuation-quiz__caption">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 3h10v3h3v15H7V3Zm2 2v14h9V8h-3V5H9Zm2 5h5v2h-5v-2Zm0 4h5v2h-5v-2ZM4 6h2v15h10v2H4V6Z"/></svg>
        Расчёт стоимости онлайн
      </span>
      <span class="valuation-quiz__counter" aria-live="polite"><b data-current-step>1</b>/6</span>
    </div>
    <div class="valuation-quiz__progress" aria-hidden="true"><span data-progress></span></div>

    <div class="valuation-quiz__body">
      <fieldset class="valuation-step is-active" data-step="1">
        <legend>Что вы хотите продать?</legend>
        <p class="valuation-step__hint">Выберите один вариант</p>
        <div class="drink-grid">
          {drinks.map((drink) => (
            <label class="drink-option">
              <input type="radio" name="category" value={drink.value} />
              <span class="drink-option__visual"><img src={drink.image} alt="" loading="lazy" /></span>
              <span>{drink.value}</span>
              <i aria-hidden="true">✓</i>
            </label>
          ))}
          <label class="drink-option drink-option--other">
            <input type="radio" name="category" value="Другое" />
            <span class="drink-option__visual"><b>?</b></span>
            <span>Другое</span>
            <i aria-hidden="true">✓</i>
          </label>
        </div>
      </fieldset>

      <fieldset class="valuation-step" data-step="2">
        <legend>Сохранилась подарочная упаковка?</legend>
        <p class="valuation-step__hint">Коробка или фирменный футляр могут повлиять на стоимость</p>
        <div class="answer-list">
          <label><input type="radio" name="package" value="Да" /><span>Да, упаковка есть</span></label>
          <label><input type="radio" name="package" value="Нет" /><span>Нет, только бутылка</span></label>
          <label><input type="radio" name="package" value="Не уверен" /><span>Не уверен</span></label>
        </div>
      </fieldset>

      <fieldset class="valuation-step" data-step="3">
        <legend>Есть документы или сертификат подлинности?</legend>
        <p class="valuation-step__hint">Если документов нет, мы всё равно сможем провести предварительную оценку</p>
        <div class="answer-list">
          <label><input type="radio" name="documents" value="Да" /><span>Да</span></label>
          <label><input type="radio" name="documents" value="Нет" /><span>Нет</span></label>
          <label><input type="radio" name="documents" value="Не знаю" /><span>Не знаю</span></label>
        </div>
      </fieldset>

      <fieldset class="valuation-step" data-step="4">
        <legend>Как к вам обращаться?</legend>
        <p class="valuation-step__hint">Имя увидит только оценщик</p>
        <label class="field-control">
          <span>Ваше имя</span>
          <input type="text" name="name" autocomplete="name" maxlength="120" placeholder="Например, Андрей" />
        </label>
      </fieldset>

      <fieldset class="valuation-step" data-step="5">
        <legend>Куда отправить результат?</legend>
        <p class="valuation-step__hint">Позвоним или напишем в мессенджер — как вам будет удобнее</p>
        <label class="field-control">
          <span>Номер телефона</span>
          <input type="tel" name="phone" autocomplete="tel" inputmode="numeric" maxlength="18" pattern="\+7 \([0-9]{3}\) [0-9]{3}-[0-9]{2}-[0-9]{2}" placeholder="+7 (___) ___-__-__" />
        </label>
      </fieldset>

      <fieldset class="valuation-step" data-step="6">
        <legend>Прикрепите фото бутылки</legend>
        <p class="valuation-step__hint">Лучше всего видны этикетка, пробка и уровень напитка. Можно добавить до 10 снимков.</p>
        <label class="photo-drop" data-photo-drop>
          <input type="file" name="photos" accept="image/jpeg,image/png,image/webp" multiple />
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 7.5 7.5 9 9l2-2v8h2V7l2 2 1.5-1.5L12 3ZM5 13H3v7h18v-7h-2v5H5v-5Z"/></svg>
          <span><b>Выберите фотографии</b> или перетащите их сюда</span>
          <small>JPG, PNG или WEBP · до 10 файлов</small>
        </label>
        <div class="photo-preview" data-photo-preview aria-live="polite"></div>
      </fieldset>

      <p class="valuation-quiz__error" data-quiz-error role="alert"></p>
      <p class="valuation-quiz__consent">Нажимая «Получить оценку», вы соглашаетесь с <a href={`${root}privacy/`} target="_blank" rel="noopener">политикой конфиденциальности</a> и обработкой персональных данных.</p>
      <div class="valuation-quiz__actions">
        <button type="button" class="quiz-back" data-back>← Назад</button>
        <button type="button" class="quiz-next" data-next>Далее <span>→</span></button>
        <button type="submit" class="quiz-next" data-submit>Получить оценку <span>→</span></button>
      </div>
    </div>

    <div class="valuation-quiz__success" data-quiz-success hidden>
      <span aria-hidden="true">✓</span>
      <h3>Заявка отправлена</h3>
      <p>В ближайшее время мы свяжемся с вами и сообщим точную стоимость.</p>
    </div>
    <input type="text" name="website" class="valuation-quiz__trap" tabindex="-1" autocomplete="off" aria-hidden="true" />
  </form>
</section>

<style>
  .valuation-quiz{--wine:#950611;--wine-dark:#65030b;--paper:#f4efe5;--ink:#270b0d;display:grid;grid-template-columns:minmax(250px,.72fr) minmax(0,1.7fr);gap:clamp(28px,4vw,70px);align-items:start;padding:clamp(58px,8vw,112px) max(24px,calc((100vw - 1360px)/2));background:#080606;color:#fff;position:relative;isolation:isolate;overflow:hidden;font-family:Arial,sans-serif}
  .valuation-quiz:before{content:"";position:absolute;inset:0;z-index:-2;background-image:linear-gradient(90deg,rgba(4,2,2,.76) 0%,rgba(5,2,3,.88) 48%,rgba(5,3,3,.93) 100%),var(--cellar-image);background-size:cover;background-position:center;filter:grayscale(1) contrast(1.08);opacity:.78}
  .valuation-quiz:after{content:"";position:absolute;inset:0;z-index:-1;pointer-events:none;background:radial-gradient(circle at 10% 32%,rgba(149,6,17,.35),transparent 31%),repeating-radial-gradient(circle at 30% 20%,rgba(255,255,255,.045) 0 1px,transparent 1px 4px);mix-blend-mode:screen;opacity:.48}
  .valuation-quiz__magnifier{position:absolute;z-index:-1;left:max(-80px,calc((100vw - 1560px)/2));top:17%;width:clamp(270px,27vw,480px);aspect-ratio:1;border:clamp(16px,2vw,30px) solid rgba(149,6,17,.12);border-radius:50%;box-shadow:inset 0 0 0 1px rgba(255,255,255,.035),0 0 80px rgba(149,6,17,.08);transform:rotate(-28deg);pointer-events:none}.valuation-quiz__magnifier:after{content:"";position:absolute;width:42%;height:clamp(18px,2vw,30px);right:-31%;bottom:4%;border-radius:999px;background:rgba(149,6,17,.12);box-shadow:0 0 40px rgba(149,6,17,.08)}
  .valuation-quiz__intro{padding-top:36px;position:sticky;top:90px}
  .valuation-quiz__eyebrow{margin:0 0 18px;color:#d71324;font-size:13px;letter-spacing:.2em;text-transform:uppercase;font-weight:700}
  .valuation-quiz__intro h2{font:400 clamp(34px,4vw,62px)/.98 Georgia,serif;letter-spacing:-.04em;text-wrap:balance;margin:0 0 24px;max-width:520px}
  .valuation-quiz__intro>p:not(.valuation-quiz__eyebrow):not(.valuation-quiz__promise){color:#d2c7c5;font-size:17px;line-height:1.65;max-width:430px;margin:0}
  .valuation-quiz__promise{max-width:430px;margin:20px 0 0;padding:15px 17px;border-left:2px solid var(--wine);background:rgba(16,7,7,.52);color:#fff;font-size:14px;line-height:1.55;backdrop-filter:blur(5px)}
  .valuation-quiz__facts{border-top:1px solid rgba(255,255,255,.16);margin-top:36px;padding-top:18px;display:grid;gap:13px;color:#a99d9d;font-size:14px}
  .valuation-quiz__facts span{display:flex;justify-content:space-between;gap:18px}.valuation-quiz__facts b{color:#fff;font-weight:600}
  .valuation-quiz__andrew{height:190px;width:150px;position:absolute;right:-86px;top:72px;z-index:2;display:flex;align-items:flex-end}.valuation-quiz__andrew img{position:absolute;inset:0;width:100%;height:100%;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 18px 24px rgba(0,0,0,.4))}.valuation-quiz__andrew span{display:none;position:relative;margin-bottom:18px;padding:10px 12px 10px 16px;border-left:1px solid var(--wine);color:#fff;background:rgba(7,3,3,.52);backdrop-filter:blur(6px)}.valuation-quiz__andrew b,.valuation-quiz__andrew small{display:block}.valuation-quiz__andrew b{font:600 13px Arial;text-transform:uppercase;letter-spacing:.08em}.valuation-quiz__andrew small{margin-top:4px;color:#fff;font-size:11px;white-space:nowrap}
  .valuation-quiz__card{background-color:var(--paper);background-image:radial-gradient(rgba(83,54,40,.1) .55px,transparent .7px),radial-gradient(rgba(255,255,255,.72) .55px,transparent .75px);background-size:4px 4px,5px 5px;background-position:0 0,2px 2px;color:var(--ink);border-radius:28px;overflow:hidden;min-height:700px;box-shadow:0 32px 80px rgba(53,0,5,.4),inset 0 0 80px rgba(112,79,47,.055);position:relative}
  .valuation-quiz__topline{min-height:112px;background:linear-gradient(110deg,var(--wine-dark),var(--wine));color:#fff;padding:0 clamp(24px,4vw,54px);display:flex;align-items:center;justify-content:space-between;gap:20px}
  .valuation-quiz__caption{display:flex;align-items:center;gap:13px;font-size:18px}.valuation-quiz__caption svg{width:26px;fill:currentColor}.valuation-quiz__counter{font-size:18px;font-variant-numeric:tabular-nums}
  .valuation-quiz__progress{height:7px;background:#d8d6d1}.valuation-quiz__progress span{display:block;width:16.666%;height:100%;background:var(--wine);transition:width .35s ease}
  .valuation-quiz__body{padding:clamp(32px,5vw,64px);min-height:580px;display:flex;flex-direction:column;background:linear-gradient(115deg,rgba(255,255,255,.16),transparent 48%,rgba(90,52,28,.025))}
  .valuation-step{display:none;border:0;margin:0;padding:0;animation:quiz-in .35s ease both}.valuation-step.is-active{display:block}
  @keyframes quiz-in{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
  .valuation-step legend{font:400 clamp(27px,3vw,42px)/1.08 Georgia,serif;letter-spacing:-.025em;text-wrap:balance;padding:0;margin:0;color:#5b1015;text-transform:none}
  .valuation-step__hint{color:#786d69;margin:10px 0 28px;font-size:15px;line-height:1.5}
  .drink-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px 16px}.drink-option{cursor:pointer;position:relative;display:grid;gap:9px;font-size:16px}.drink-option input{position:absolute;opacity:0}.drink-option__visual{height:132px;padding:8px;background:#51141c;overflow:hidden;border:2px solid transparent;border-radius:12px;box-sizing:border-box;transition:.2s ease;display:flex;align-items:center;justify-content:center}.drink-option__visual img{width:100%;height:100%;object-fit:contain;object-position:center;filter:saturate(.82)}.drink-option--other .drink-option__visual b{font:400 68px/1 Georgia,serif;color:#fff}.drink-option i{display:none;position:absolute;right:-8px;top:-8px;width:31px;height:31px;border-radius:50%;background:var(--wine);color:#fff;font:700 18px/31px Arial;text-align:center;font-style:normal}.drink-option:hover .drink-option__visual{transform:translateY(-2px);border-color:var(--wine)}.drink-option input:focus-visible+.drink-option__visual{outline:3px solid var(--wine);outline-offset:3px}.drink-option:has(input:checked) .drink-option__visual{border-color:var(--wine);box-shadow:0 8px 18px rgba(92,5,13,.18)}.drink-option:has(input:checked) i{display:block}
  .answer-list{display:grid;gap:12px;max-width:680px}.answer-list label{position:relative;cursor:pointer}.answer-list input{position:absolute;opacity:0}.answer-list span{display:flex;align-items:center;min-height:62px;padding:0 20px 0 58px;border:1px solid #d5c8bb;border-radius:12px;background:rgba(255,255,255,.34);font-size:17px;transition:.2s}.answer-list span:before{content:"";position:absolute;left:20px;width:20px;height:20px;border:2px solid #a47470;border-radius:50%}.answer-list input:checked+span{border-color:var(--wine);background:#fff}.answer-list input:checked+span:before{border:6px solid var(--wine);width:12px;height:12px}.answer-list input:focus-visible+span{outline:3px solid var(--wine);outline-offset:2px}
  .field-control{display:grid;gap:10px;max-width:760px}.field-control span{font-size:14px;font-weight:700}.field-control input{height:72px;border:1px solid #d4c9bd;background:rgba(255,255,255,.65);padding:0 22px;font:400 19px Arial;border-radius:14px;color:var(--ink);outline:0}.field-control input:focus{border-color:var(--wine);box-shadow:0 0 0 3px rgba(149,6,17,.1)}
  .photo-drop{min-height:190px;border:1.5px dashed #a58d7c;border-radius:22px;background:rgba(255,255,255,.45);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:9px;cursor:pointer;padding:24px;transition:.2s}.photo-drop:hover,.photo-drop.is-dragging{background:#fff;border-color:var(--wine)}.photo-drop input{position:absolute;opacity:0;width:1px;height:1px}.photo-drop svg{width:40px;fill:var(--wine)}.photo-drop span{font-size:16px}.photo-drop b{color:var(--wine)}.photo-drop small{color:#82746f}.photo-preview{display:flex;gap:8px;flex-wrap:wrap;margin-top:12px}.photo-preview span{background:#e4ddd2;border-radius:999px;padding:7px 12px;font-size:12px;max-width:180px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .valuation-quiz__consent{margin:14px 0 0;font-size:12px;line-height:1.5;color:#7a6f6b}.valuation-quiz__consent a{color:inherit;text-decoration:underline}
  .valuation-quiz__actions{display:flex;justify-content:space-between;align-items:center;margin-top:auto;padding-top:32px}.valuation-quiz__body:has([data-step="6"].is-active){min-height:0}.valuation-quiz__body:has([data-step="6"].is-active) .valuation-quiz__actions{margin-top:8px}.quiz-back,.quiz-next{border:0;border-radius:14px;cursor:pointer;font:600 16px Arial;transition:.2s ease}.quiz-back{background:none;color:#554b48;padding:14px 0}.quiz-back:hover{color:var(--wine)}.quiz-next{display:inline-flex;align-items:center;justify-content:center;background:var(--wine);color:#fff;padding:17px 25px;min-width:154px}.quiz-next:hover{background:var(--wine-dark);transform:translateY(-2px)}.quiz-next:active{transform:translateY(0)}.quiz-next:focus-visible,.quiz-back:focus-visible{outline:3px solid var(--wine);outline-offset:3px}.quiz-next span{margin-left:12px}.quiz-next:disabled{opacity:.58;cursor:wait;transform:none}[data-submit]{display:none}.valuation-quiz__error{color:#b0000d;font-size:14px;margin:14px 0 -12px;min-height:18px}.valuation-quiz__trap{position:absolute;left:-10000px}
  .valuation-quiz__success{position:absolute;inset:119px 0 0;background:var(--paper);display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;padding:40px}.valuation-quiz__success[hidden]{display:none}.valuation-quiz__success>span{width:74px;height:74px;border-radius:50%;display:grid;place-items:center;background:var(--wine);color:#fff;font-size:36px}.valuation-quiz__success h3{font:400 38px Georgia,serif;color:#5b1015;margin:24px 0 12px}.valuation-quiz__success p{max-width:470px;color:#6e6260;line-height:1.6;margin:0}
  @media(max-width:1050px){.valuation-quiz{grid-template-columns:1fr;padding-inline:24px}.valuation-quiz__intro{position:static;padding-top:0}.valuation-quiz__intro h2{max-width:720px}.valuation-quiz__intro>p:not(.valuation-quiz__eyebrow):not(.valuation-quiz__promise),.valuation-quiz__promise{max-width:680px}.valuation-quiz__facts{grid-template-columns:repeat(3,1fr)}.valuation-quiz__facts span{display:grid}.valuation-quiz__andrew{right:16px;top:92px;width:180px;height:230px}.valuation-quiz__card{min-height:650px}}
  @media(max-width:700px){.valuation-quiz{padding:54px 12px}.valuation-quiz__facts{grid-template-columns:1fr}.valuation-quiz__facts span{display:flex}.valuation-quiz__andrew{position:relative;right:auto;top:auto;width:auto;height:132px;margin-top:16px;padding-left:116px}.valuation-quiz__andrew img{width:150px;height:190px;left:-20px;bottom:-22px}.valuation-quiz__card{min-height:660px}.valuation-quiz__topline{min-height:86px}.valuation-quiz__caption{font-size:15px}.valuation-quiz__body{padding:28px 20px;min-height:560px}.drink-grid{grid-template-columns:repeat(2,1fr);gap:16px 12px}.drink-option__visual{height:100px}.valuation-step legend{font-size:27px}.valuation-step__hint{margin-bottom:22px}.quiz-next{min-width:135px;padding:15px 17px}.valuation-quiz__success{inset:93px 0 0}.valuation-quiz__success h3{font-size:31px}}
</style>

<script>
  const initializeQuiz = (form: Element) => {
    if (!(form instanceof HTMLFormElement) || form.dataset.ready === 'true') return;
    form.dataset.ready = 'true';
    const steps = Array.from(form.querySelectorAll('[data-step]'));
    const next = form.querySelector('[data-next]');
    const back = form.querySelector('[data-back]');
    const submit = form.querySelector('[data-submit]');
    const currentLabel = form.querySelector('[data-current-step]');
    const progress = form.querySelector('[data-progress]');
    const error = form.querySelector('[data-quiz-error]');
    const fileInput = form.querySelector('input[type="file"]');
    const phoneInput = form.querySelector('input[name="phone"]');
    const preview = form.querySelector('[data-photo-preview]');
    const drop = form.querySelector('[data-photo-drop]');
    let current = 0;

    const fieldValue = (name: string) => {
      const field = form.elements.namedItem(name);
      return field instanceof RadioNodeList || field instanceof HTMLInputElement || field instanceof HTMLTextAreaElement
        ? field.value
        : '';
    };

    const setError = (message = '') => { if (error) error.textContent = message; };
    const renderFiles = () => {
      if (!preview || !(fileInput instanceof HTMLInputElement)) return;
      preview.replaceChildren(...Array.from(fileInput.files || []).map((file) => {
        const item = document.createElement('span'); item.textContent = file.name; return item;
      }));
    };
    const showStep = (index: number) => {
      current = Math.max(0, Math.min(steps.length - 1, index));
      steps.forEach((step, i) => step.classList.toggle('is-active', i === current));
      if (currentLabel) currentLabel.textContent = String(current + 1);
      if (progress instanceof HTMLElement) progress.style.width = `${((current + 1) / steps.length) * 100}%`;
      if (back instanceof HTMLElement) back.style.visibility = current === 0 ? 'hidden' : 'visible';
      if (next instanceof HTMLElement) next.style.display = current === steps.length - 1 ? 'none' : '';
      if (submit instanceof HTMLElement) submit.style.display = current === steps.length - 1 ? 'inline-flex' : 'none';
      setError();
    };
    const validate = () => {
      if (current <= 2 && !form.querySelector(`[data-step="${current + 1}"] input:checked`)) return 'Выберите один из вариантов';
      if (current === 3 && !fieldValue('name').trim()) return 'Укажите ваше имя';
      if (current === 4 && fieldValue('phone').replace(/\D/g, '').length < 10) return 'Укажите корректный номер телефона';
      if (current === 5) {
        const count = fileInput instanceof HTMLInputElement ? fileInput.files?.length || 0 : 0;
        if (!count) return 'Добавьте хотя бы одну фотографию';
        if (count > 10) return 'Можно добавить не более 10 фотографий';
      }
      return '';
    };
    next?.addEventListener('click', () => { const message = validate(); if (message) return setError(message); showStep(current + 1); });
    back?.addEventListener('click', () => showStep(current - 1));
    steps.slice(0, 3).forEach((step) => step.addEventListener('change', () => setError()));
    fileInput?.addEventListener('change', () => { renderFiles(); setError(); });
    phoneInput?.addEventListener('input', () => {
      if (!(phoneInput instanceof HTMLInputElement)) return;
      let digits = phoneInput.value.replace(/\D/g, '');
      if (digits.startsWith('8')) digits = `7${digits.slice(1)}`;
      if (!digits.startsWith('7')) digits = `7${digits}`;
      digits = digits.slice(0, 11);
      const local = digits.slice(1);
      let value = '+7';
      if (local.length) value += ` (${local.slice(0, 3)}`;
      if (local.length >= 3) value += ')';
      if (local.length > 3) value += ` ${local.slice(3, 6)}`;
      if (local.length > 6) value += `-${local.slice(6, 8)}`;
      if (local.length > 8) value += `-${local.slice(8, 10)}`;
      phoneInput.value = value;
      setError();
    });
    ['dragenter','dragover'].forEach((eventName) => drop?.addEventListener(eventName, (event) => { event.preventDefault(); drop.classList.add('is-dragging'); }));
    ['dragleave','drop'].forEach((eventName) => drop?.addEventListener(eventName, () => drop.classList.remove('is-dragging')));
    drop?.addEventListener('drop', (event) => {
      event.preventDefault();
      const dragEvent = event as DragEvent;
      if (!(fileInput instanceof HTMLInputElement) || !dragEvent.dataTransfer?.files.length) return;
      const transfer = new DataTransfer(); Array.from(dragEvent.dataTransfer.files).slice(0, 10).forEach((file) => transfer.items.add(file)); fileInput.files = transfer.files; renderFiles();
    });
    form.addEventListener('submit', async (event) => {
      event.preventDefault(); const message = validate(); if (message) return setError(message);
      const files = fileInput instanceof HTMLInputElement ? Array.from(fileInput.files || []) : [];
      const invalidFile = files.find((file) => !['image/jpeg', 'image/png', 'image/webp'].includes(file.type));
      if (invalidFile) return setError(`Файл «${invalidFile.name}» должен быть в формате JPG, PNG или WEBP`);
      const oversizedFile = files.find((file) => file.size > 10 * 1024 * 1024);
      if (oversizedFile) return setError(`Файл «${oversizedFile.name}» больше 10 МБ`);
      const data = new FormData();
      data.set('category', fieldValue('category')); data.set('name', fieldValue('name')); data.set('phone', fieldValue('phone'));
      data.set('message', `Подарочная упаковка: ${fieldValue('package')}\nДокументы/сертификат: ${fieldValue('documents')}\nИсточник: онлайн-тест на главной`);
      data.set('source', `${window.location.href}#online-valuation`); data.set('website', fieldValue('website'));
      files.forEach((file) => data.append('photos', file, file.name));
      if (submit instanceof HTMLButtonElement) { submit.disabled = true; submit.innerHTML = 'Отправляем…'; }
      try {
        const response = await fetch('/api/applications/web', { method: 'POST', body: data });
        const result = await response.json().catch(() => null);
        if (!response.ok || !result?.uuid) throw new Error(typeof result?.detail === 'string' ? result.detail : 'Не удалось отправить заявку');
        const body = form.querySelector('.valuation-quiz__body'); const success = form.querySelector('[data-quiz-success]');
        if (body instanceof HTMLElement) body.hidden = true; if (success instanceof HTMLElement) success.hidden = false;
      } catch (reason) { setError(reason instanceof Error ? reason.message : 'Не удалось отправить заявку'); if (submit instanceof HTMLButtonElement) { submit.disabled = false; submit.innerHTML = 'Получить оценку <span>→</span>'; } }
    });
    showStep(0);
  };
  document.querySelectorAll('[data-valuation-quiz]').forEach(initializeQuiz);
</script>
