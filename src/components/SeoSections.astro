---
import { articles, faqs } from '../data/articles';
import journalBackground from '../assets/article-backgrounds/chicago-library-archive.jpg';

const categories = [
  ['all', 'Все статьи'],
  ['wine', 'Вино'],
  ['champagne', 'Шампанское'],
  ['whisky', 'Виски'],
  ['cognac', 'Коньяк'],
  ['portwine', 'Портвейн'],
  ['rum', 'Ром'],
  ['vodka', 'Водка'],
  ['brandy', 'Бренди'],
  ['guide', 'Гид по оценке'],
];

const articleCards = articles.map((article, index) => {
  const articleText = [article.intro, ...article.sections.flatMap((section) => [section.title, ...section.paragraphs]), ...article.checklist, article.note].join(' ');
  return { ...article, number: String(index + 1).padStart(2, '0'), readingMinutes: Math.max(3, Math.ceil(articleText.split(/\s+/).length / 180)) };
});
const journalBackgroundSrc = `.${journalBackground.src}`;
---

<section class="editorial home-journal" aria-labelledby="articles-title" data-home-journal>
  <img class="home-journal__backdrop" src={journalBackgroundSrc} alt="" aria-hidden="true" decoding="async" fetchpriority="low" width={journalBackground.width} height={journalBackground.height} />
  <span class="home-journal__grain" aria-hidden="true"></span>
  <div class="home-journal__inner">
    <header class="home-journal__header">
      <div>
        <p class="home-journal__kicker"><span>Журнал Andrewine</span><span>Архив коллекционера</span></p>
        <p class="editorial__eyebrow">Истории, марки и оценка</p>
        <h2 id="articles-title">Архив редких бутылок</h2>
      </div>
      <div class="home-journal__intro">
        <p>Разбираем происхождение, состояние и детали выпуска без мифов и громких обещаний.</p>
        <a href="./articles/">Открыть весь журнал <span aria-hidden="true">↗</span></a>
      </div>
    </header>

    <div class="home-journal__toolbar">
      <div class="home-journal__filters" aria-label="Фильтр статей по виду алкоголя">
        {categories.map(([value, label], index) => (
          <button type="button" data-journal-filter={value} aria-pressed={index === 0 ? 'true' : 'false'}>{label}</button>
        ))}
      </div>
      <p class="home-journal__count" aria-live="polite"><span data-journal-count>3 из {articleCards.length} материалов</span></p>
    </div>

    <div class="home-journal__grid" data-journal-grid data-count={Math.min(3, articleCards.length)}>
      {articleCards.map((article, index) => (
        <article class="home-journal-card" data-journal-card data-category={article.category} data-layout={index === 0 ? 'feature' : index < 3 ? 'compact' : 'regular'} hidden={index >= 3}>
          <a class="home-journal-card__media" href={`./articles/${article.slug}/`} aria-label={`Читать: ${article.title}`}>
            <img src={article.image} alt={article.imageAlt} loading="lazy" decoding="async" width="900" height="680" />
            <span class="home-journal-card__file" aria-hidden="true">Досье {article.number}</span>
          </a>
          <div class="home-journal-card__content">
            <p class="home-journal-card__category">{article.eyebrow}</p>
            <h3><a href={`./articles/${article.slug}/`}>{article.title}</a></h3>
            <p class="home-journal-card__text">{article.description}</p>
            <div class="home-journal-card__meta">
              <span>{article.readingMinutes} минут чтения</span>
              <a href={`./articles/${article.slug}/`} aria-label={`Читать статью: ${article.title}`}>Читать <span aria-hidden="true">↗</span></a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="home-journal__all">
      <span aria-hidden="true"></span>
      <a href="./articles/">Смотреть все статьи <small>{articleCards.length} материалов</small><b aria-hidden="true">↗</b></a>
      <span aria-hidden="true"></span>
    </div>
  </div>
</section>

<script is:inline>
  (() => {
    const section = document.querySelector('[data-home-journal]');
    if (!section) return;
    const buttons = Array.from(section.querySelectorAll('[data-journal-filter]'));
    const cards = Array.from(section.querySelectorAll('[data-journal-card]'));
    const grid = section.querySelector('[data-journal-grid]');
    const count = section.querySelector('[data-journal-count]');
    const countLabel = (value) => value === 1 ? '1 материал' : value > 1 && value < 5 ? `${value} материала` : `${value} материалов`;

    const applyFilter = (category) => {
      const matching = cards.filter((card) => category === 'all' || card.dataset.category === category);
      const visible = matching.slice(0, 3);
      cards.forEach((card) => {
        card.hidden = !visible.includes(card);
        card.dataset.layout = 'regular';
      });
      visible.forEach((card, index) => {
        card.dataset.layout = index === 0 ? 'feature' : visible.length > 2 && index < 3 ? 'compact' : 'regular';
      });
      buttons.forEach((button) => button.setAttribute('aria-pressed', String(button.dataset.journalFilter === category)));
      if (grid) grid.dataset.count = String(visible.length);
      if (count) count.textContent = matching.length > 3 ? `${visible.length} из ${matching.length} материалов` : countLabel(matching.length);
    };

    buttons.forEach((button) => button.addEventListener('click', () => applyFilter(button.dataset.journalFilter || 'all')));
  })();
</script>

<section class="faq home-faq" aria-labelledby="faq-title">
  <div class="faq__inner home-faq__inner">
    <div class="home-faq__layout">
      <header class="home-faq__heading">
        <p class="editorial__eyebrow">Перед обращением</p>
        <h2 id="faq-title">Что важно знать до оценки</h2>
        <p class="home-faq__intro">Короткие ответы о фотографиях, стоимости и состоянии бутылки — без сложных терминов и завышенных обещаний.</p>
        <a class="home-faq__cta" href="#request">Отправить фотографии <span aria-hidden="true">→</span></a>
      </header>
      <div class="faq__list home-faq__list">
        {faqs.map(([question, answer]) => (
          <details class="faq__item" name="home-faq">
          <summary>{question}<span aria-hidden="true">+</span></summary>
          <p>{answer}</p>
        </details>
      ))}
      </div>
    </div>
  </div>
</section>

<script is:inline type="application/ld+json" set:html={JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(([name, text]) => ({ '@type': 'Question', name, acceptedAnswer: { '@type': 'Answer', text } })),
})} />
