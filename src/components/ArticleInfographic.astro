---
import investigationPaper from '../assets/editorial/investigation-paper.jpg';

interface Props {
  pack: {
    eyebrow: string;
    title: string;
    note: string;
    character: ImageMetadata;
    characterAlt: string;
    items: readonly (readonly [ImageMetadata, string])[];
  };
  compact?: boolean;
}

const { pack, compact = false } = Astro.props;
const articleAssetUrl = (src: string) => `../../${src.replace(/^\//, '')}`;
const paperUrl = articleAssetUrl(investigationPaper.src);
---

<section class:list={['article-infographic', { 'article-infographic--compact': compact }]} style={`--dossier-paper:url("${paperUrl}")`}>
  <span class="article-infographic__stamp" aria-hidden="true">Досье / 04</span>
  <div class="article-infographic__heading">
    <div>
      <p class="editorial__eyebrow">{pack.eyebrow}</p>
      <h2>{pack.title}</h2>
    </div>
    <p class="article-infographic__note">{pack.note}</p>
  </div>
  <div class="article-infographic__layout">
    <div class="article-infographic__grid">
      {pack.items.map(([image, label], index) => (
        <figure class="article-infographic__evidence">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <img src={articleAssetUrl(image.src)} alt="" loading="lazy" decoding="async" width={image.width} height={image.height} />
          <figcaption>{label}</figcaption>
        </figure>
      ))}
    </div>
    <figure class="article-infographic__andrew">
      <img src={articleAssetUrl(pack.character.src)} alt={pack.characterAlt} loading="lazy" decoding="async" width={pack.character.width} height={pack.character.height} />
      <figcaption><span>Эндрю</span> / заметка оценщика</figcaption>
    </figure>
  </div>
</section>
