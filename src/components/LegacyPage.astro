---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import SeoSections from './SeoSections.astro';
import enhancementsCss from '../styles/enhancements.css?raw';
import { rewriteLegacyLinks } from '../lib/legacyChrome';

interface Props {
  file: string;
  editorial?: boolean;
}

const { file, editorial = false } = Astro.props;
const fileRoutes: Record<string, string> = {
  'page132437346.html': '/',
  'page136045756.html': '/buy_champagne',
  'page136045966.html': '/buy_whisky',
  'page136046316.html': '/buy_cognac',
  'page136046936.html': '/buy_portwine',
  'page136047606.html': '/buy_rum',
  'page136048186.html': '/buy_vodka',
  'page136049296.html': '/buy_brandy',
  'page136462246.html': '/buy_wine',
};

const heroRecordByFile: Record<string, string> = {
  'page132437346.html': 'rec2153096741',
  'page136045756.html': 'rec2183097071',
  'page136045966.html': 'rec2187393971',
  'page136046316.html': 'rec2187529151',
  'page136046936.html': 'rec2187641621',
  'page136047606.html': 'rec2187700811',
  'page136048186.html': 'rec2187722761',
  'page136049296.html': 'rec2187785841',
  'page136462246.html': 'rec2189792391',
};

const sectionRecordByFile: Record<string, string> = {
  'page132437346.html': 'rec2127258581',
  'page136045756.html': 'rec2186910541',
  'page136045966.html': 'rec2187315621',
  'page136046316.html': 'rec2187446001',
  'page136046936.html': 'rec2187546781',
  'page136047606.html': 'rec2187648331',
  'page136048186.html': 'rec2187723531',
  'page136049296.html': 'rec2187763411',
  'page136462246.html': 'rec2189803901',
};

// The category SEO record (Tilda T123) ships as raw HTML: an <h1> followed by
// <h2> sections. Rebuild it as the same accordion the home page FAQ uses, with
// each <h2> becoming a question and everything up to the next <h2> its answer.
// The title drops to <h2> so the page keeps a single <h1> (the hero one).
const buildCategoryFaq = (html: string) =>
  html.replace(/<!-- nominify begin -->([\s\S]*?)<!-- nominify end -->/g, (whole, inner: string) => {
    const title = inner.match(/<h1>([\s\S]*?)<\/h1>/)?.[1]?.trim();
    if (!title) return whole;

    const items = inner
      .slice(inner.indexOf('</h1>') + 5)
      .split(/(?=<h2>)/)
      .filter((part) => /<h2>/.test(part))
      .map((part) => {
        const question = part.match(/<h2>([\s\S]*?)<\/h2>/)?.[1]?.trim() ?? '';
        const answer = part.slice(part.indexOf('</h2>') + 5).trim();
        return `<details class="faq__item" name="category-faq"><summary>${question}<span aria-hidden="true">+</span></summary><div class="faq__answer">${answer}</div></details>`;
      })
      .join('');

    return `<section class="faq home-faq category-faq" aria-labelledby="category-faq-title"><div class="faq__inner home-faq__inner"><div class="home-faq__layout"><header class="home-faq__heading"><p class="editorial__eyebrow">Частые вопросы</p><h2 id="category-faq-title">${title}</h2><a class="home-faq__cta" href="#request">Отправить фотографии <span aria-hidden="true">→</span></a></header><div class="faq__list home-faq__list">${items}</div></div></div></section>`;
  });

const brandRailMarkup = (variant: 'hero' | 'section') =>
  `<div class="brand-rail brand-rail--${variant}" aria-hidden="true"><span class="brand-rail__line"></span><span class="brand-rail__copy"><span class="brand-rail__brand">ANDREWINE</span><small>Выкуп элитного алкоголя</small></span><span class="brand-rail__line"></span></div>`;

const injectBrandRail = (html: string, recordId: string, variant: 'hero' | 'section') =>
  html.replace(
    new RegExp(`(<div id="${recordId}")([^>]*>)`),
    `$1 data-brand-rail-host="${variant}"$2${brandRailMarkup(variant)}`,
  );

let source = readFileSync(path.join(process.cwd(), 'src', 'legacy', file), 'utf8');

source = source
  .replaceAll('https://xn--80aexbctj5a4e.xn--p1ai', 'https://andrewine.ru')
  .replaceAll('http://xn--80aexbctj5a4e.xn--p1ai', 'https://andrewine.ru')
  .replaceAll('https://алковыкуп.рф', 'https://andrewine.ru')
  .replaceAll('http://алковыкуп.рф', 'https://andrewine.ru');

// The original vertical experience badge is a small raster image and becomes
// visibly blurred after Tilda scales and rotates it. Keep the original layout,
// but replace both lazy-load URLs with a crisp, locally drawn SVG.
source = source
  .replaceAll('https://static.tildacdn.com/tild6164-6333-4835-a466-626266363438/Group_10.png', 'https://selkorin.github.io/andrewine/assets/experience-badge.svg')
  .replaceAll('https://thb.tildacdn.com/tild6164-6333-4835-a466-626266363438/-/resize/20x/Group_10.png', 'https://selkorin.github.io/andrewine/assets/experience-badge.svg');

for (const lineAsset of [
  'tild6364-3939-4137-b533-386662663831',
  'tild3930-3936-4337-a661-336165396539',
  'tild3237-3363-4836-a331-653463626463',
  'tild3366-3661-4630-b061-613364393634',
]) {
  source = source
    .replaceAll(`https://static.tildacdn.com/${lineAsset}/_.png`, 'https://selkorin.github.io/andrewine/assets/section-line.svg')
    .replaceAll(`https://thb.tildacdn.com/${lineAsset}/-/resize/20x/_.png`, 'https://selkorin.github.io/andrewine/assets/section-line.svg');
}

for (const [pageFile, route] of Object.entries(fileRoutes)) {
  source = source.replaceAll(pageFile, route);
}

// Tilda export contains duplicated closing tags and a fragment of an old SEO
// snippet outside <script>. Browsers render that fragment as `}}}})` and can
// leave the original Tilda records hidden. Remove only those broken leftovers.
source = source
  .replace(/<\/script>\s*\}\s*\}\s*\}\s*\}\s*\)\s*<\/script>/g, '</script>')
  .replaceAll('</script></script></style>', '</script>')
  .replaceAll('</script></script><!-- nominify end -->', '</script><!-- nominify end -->');

source = source
  .replaceAll('href="https://andrewine.ru/premium_alcohol"', 'href="https://andrewine.ru/"')
  .replaceAll("href='https://andrewine.ru/premium_alcohol'", "href='https://andrewine.ru/'")
  .replaceAll('href="/premium_alcohol"', 'href="/"')
  .replaceAll("href='/premium_alcohol'", "href='/'");

const head = source.match(/<head[^>]*>([\s\S]*?)<\/head>/i)?.[1] ?? '';
const body = source.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? '';
const footerIndex = body.indexOf('<!--footer-->');
const root = file === 'page132437346.html' ? './' : '../';
let contentBeforeFooter = rewriteLegacyLinks(footerIndex >= 0 ? body.slice(0, footerIndex) : body, root);
const footerAndScripts = rewriteLegacyLinks(footerIndex >= 0 ? body.slice(footerIndex) : '', root);

const heroRecord = heroRecordByFile[file];
if (heroRecord) {
  contentBeforeFooter = injectBrandRail(contentBeforeFooter, heroRecord, 'hero');
}

const sectionRecord = sectionRecordByFile[file];
if (sectionRecord) {
  contentBeforeFooter = injectBrandRail(contentBeforeFooter, sectionRecord, 'section');
}

contentBeforeFooter = buildCategoryFaq(contentBeforeFooter);
---

<!doctype html>
<html lang="ru">
  <head>
    <Fragment set:html={head} />
    <style is:inline set:html={enhancementsCss} />
    <style is:global id="tilda-records-visibility-fix">.t-records{opacity:1!important}</style>
  </head>
  <body class:list={['t-body', 'legacy-page', { 'home-page': editorial }]} style="margin:0;">
    <Fragment set:html={contentBeforeFooter} />
    {editorial && <SeoSections />}
    <Fragment set:html={footerAndScripts} />
    <script is:inline>
      (() => {
        document.querySelectorAll('[data-brand-rail-host="hero"]').forEach((host) => {
          const title = host.querySelector('.tn-elem[data-elem-id="1776083437912000010"] .tn-atom');
          if (title instanceof HTMLElement) {
            const echo = title.cloneNode(true);
            echo.querySelectorAll('br').forEach((br) => br.replaceWith('\n'));
            title.dataset.heroOutline = echo.textContent?.trim() ?? '';
          }
        });
        const alignBrandRails = () => {
          document.querySelectorAll('[data-brand-rail-host]').forEach((host) => {
            const variant = host.getAttribute('data-brand-rail-host');
            const rail = host.querySelector('.brand-rail');
            const redBandId = variant === 'hero' ? '1776082148255' : '1775516228225';
            const redBand = host.querySelector(`.tn-elem[data-elem-id="${redBandId}"]`);
            if (!(rail instanceof HTMLElement) || !(redBand instanceof HTMLElement)) return;
            const hostBox = host.getBoundingClientRect();
            const bandBox = redBand.getBoundingClientRect();
            const inset = Math.max(8, Math.min(22, bandBox.height * .04));
            const availableHeight = Math.max(0, bandBox.height - inset * 2);
            const railHeight = Math.min(availableHeight, bandBox.height * .8, hostBox.height * .6);
            const centeredTop = bandBox.top - hostBox.top + (bandBox.height - railHeight) / 2;
            rail.style.top = `${centeredTop}px`;
            rail.style.height = `${railHeight}px`;
            rail.dataset.aligned = 'true';
          });
        };
        requestAnimationFrame(alignBrandRails);
        window.addEventListener('load', alignBrandRails, { once: true });
        window.addEventListener('resize', alignBrandRails, { passive: true });
        if ('ResizeObserver' in window) {
          const observer = new ResizeObserver(alignBrandRails);
          document.querySelectorAll('[data-brand-rail-host]').forEach((host) => {
            observer.observe(host);
            const variant = host.getAttribute('data-brand-rail-host');
            const redBandId = variant === 'hero' ? '1776082148255' : '1775516228225';
            const redBand = host.querySelector(`.tn-elem[data-elem-id="${redBandId}"]`);
            if (redBand) observer.observe(redBand);
          });
        }
        document.fonts?.ready.then(alignBrandRails);
      })();
    </script>
  </body>
</html>
