---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import SeoSections from './SeoSections.astro';
import enhancementsCss from '../styles/enhancements.css?raw';
import { rewriteLegacyLinks } from '../lib/legacyChrome';

interface Props {
  file: string;
  editorial?: boolean;
}

const { file, editorial = false } = Astro.props;
const fileRoutes: Record<string, string> = {
  'page132437346.html': '/',
  'page136045756.html': '/buy_champagne',
  'page136045966.html': '/buy_whisky',
  'page136046316.html': '/buy_cognac',
  'page136046936.html': '/buy_portwine',
  'page136047606.html': '/buy_rum',
  'page136048186.html': '/buy_vodka',
  'page136049296.html': '/buy_brandy',
  'page136462246.html': '/buy_wine',
};

let source = readFileSync(path.join(process.cwd(), 'src', 'legacy', file), 'utf8');

source = source
  .replaceAll('https://xn--80aexbctj5a4e.xn--p1ai', 'https://andrewine.ru')
  .replaceAll('http://xn--80aexbctj5a4e.xn--p1ai', 'https://andrewine.ru')
  .replaceAll('https://алковыкуп.рф', 'https://andrewine.ru')
  .replaceAll('http://алковыкуп.рф', 'https://andrewine.ru');

// The exported LocalBusiness block still carries the previous brand and a
// Moscow-only service area. Search engines read the schema name as the
// business identity, so leaving «Алковыкуп» on an Andrewine site splits the
// brand signal; adding Russia alongside Moscow matches the stated coverage.
source = source
  .replaceAll('"name": "Алковыкуп",', '"name": "Andrewine",')
  .replaceAll('"alternateName": "Алковыкуп.рф",', '"alternateName": "Андревайн",')
  .replaceAll(
    '"areaServed": {\n    "@type": "City",\n    "name": "Москва"\n  },',
    '"areaServed": [\n    { "@type": "City", "name": "Москва" },\n    { "@type": "Country", "name": "Россия" }\n  ],',
  );

// The original vertical experience badge is a small raster image and becomes
// visibly blurred after Tilda scales and rotates it. Keep the original layout,
// but replace both lazy-load URLs with a crisp, locally drawn SVG.
source = source
  .replaceAll('https://static.tildacdn.com/tild6164-6333-4835-a466-626266363438/Group_10.png', 'https://selkorin.github.io/andrewine/assets/experience-badge.svg')
  .replaceAll('https://thb.tildacdn.com/tild6164-6333-4835-a466-626266363438/-/resize/20x/Group_10.png', 'https://selkorin.github.io/andrewine/assets/experience-badge.svg');

for (const lineAsset of [
  'tild6364-3939-4137-b533-386662663831',
  'tild3930-3936-4337-a661-336165396539',
  'tild3237-3363-4836-a331-653463626463',
  'tild3366-3661-4630-b061-613364393634',
]) {
  source = source
    .replaceAll(`https://static.tildacdn.com/${lineAsset}/_.png`, 'https://selkorin.github.io/andrewine/assets/section-line.svg')
    .replaceAll(`https://thb.tildacdn.com/${lineAsset}/-/resize/20x/_.png`, 'https://selkorin.github.io/andrewine/assets/section-line.svg');
}

for (const [pageFile, route] of Object.entries(fileRoutes)) {
  source = source.replaceAll(pageFile, route);
}

// Tilda export contains duplicated closing tags and a fragment of an old SEO
// snippet outside <script>. Browsers render that fragment as `}}}})` and can
// leave the original Tilda records hidden. Remove only those broken leftovers.
source = source
  .replace(/<\/script>\s*\}\s*\}\s*\}\s*\}\s*\)\s*<\/script>/g, '</script>')
  .replaceAll('</script></script></style>', '</script>')
  .replaceAll('</script></script><!-- nominify end -->', '</script><!-- nominify end -->');

// The export injects a second, visually hidden h1 (position:absolute;
// left:-9999px) stuffed with keywords on DOMContentLoaded. Text hidden from
// users but served to crawlers is cloaking — a documented spam technique —
// and it also gave every page two h1s in the live DOM. Drop the injector: the
// visible hero h1 and the T123 heading already carry the same keywords.
source = source.replace(
  /<script>\s*document\.addEventListener\('DOMContentLoaded',\s*function\(\)\s*\{\s*var h\s*=\s*document\.createElement\('h1'\)[\s\S]*?<\/script>/g,
  '',
);

// Raw T123 "HTML-код" records carry their own h1/h2/h3 ladder. Shift it one
// level down so the page keeps a single h1 (the hero), preserving hierarchy;
// enhancements.css styles .t123 to match the editorial sections.
source = source.replace(/(<div id="rec\d+"[^>]*data-record-type="131"[\s\S]*?)(?=<div id="rec|<\/footer>|<!--\/allrecords-->)/g, (block) =>
  block
    .replaceAll('<h3>', '<h4>').replaceAll('</h3>', '</h4>')
    .replaceAll('<h2>', '<h3>').replaceAll('</h2>', '</h3>')
    .replaceAll('<h1>', '<h2>').replaceAll('</h1>', '</h2>'));

const head = source.match(/<head[^>]*>([\s\S]*?)<\/head>/i)?.[1] ?? '';
let body = source.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? '';

// Some pages mark a second decorative t396 heading as h1. Demote every h1
// after the first one to h2: t396 element styles target classes, not tags,
// so the visual design is unaffected while each page keeps exactly one h1.
let h1Opened = 0;
let h1Closed = 0;
body = body.replace(/<(\/?)h1([^>]*)>/gi, (tag, closing, attrs) => {
  if (!closing) {
    h1Opened += 1;
    return h1Opened === 1 ? tag : `<h2${attrs}>`;
  }
  h1Closed += 1;
  return h1Closed === 1 ? tag : '</h2>';
});
const footerIndex = body.indexOf('<!--footer-->');
const root = file === 'page132437346.html' ? './' : '../';
const contentBeforeFooter = rewriteLegacyLinks(footerIndex >= 0 ? body.slice(0, footerIndex) : body, root);
const footerAndScripts = rewriteLegacyLinks(footerIndex >= 0 ? body.slice(footerIndex) : '', root);
---

<!doctype html>
<html lang="ru">
  <head>
    <Fragment set:html={head} />
    <style is:inline set:html={enhancementsCss} />
    <style is:global id="tilda-records-visibility-fix">.t-records{opacity:1!important}</style>
  </head>
  <body class="t-body" style="margin:0;">
    <Fragment set:html={contentBeforeFooter} />
    {editorial && <SeoSections />}
    <Fragment set:html={footerAndScripts} />
  </body>
</html>
