---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import SeoSections from './SeoSections.astro';
import CategoryArticles from './CategoryArticles.astro';
import CategorySeoContent from './CategorySeoContent.astro';
import SiteHeader from './SiteHeader.astro';
import enhancementsCss from '../styles/enhancements.css?raw';
import { rewriteLegacyLinks, resolveVendorPaths, resolveTildaHead } from '../lib/legacyChrome';
import { rebuildLegacyCategoryFaq, renderCategoryFaqFromData } from '../lib/categoryFaq';
import { categoryFaqs } from '../data/categoryFaq';
import LandingSeoHead from './LandingSeoHead.astro';
import YandexMetrika from './YandexMetrika.astro';
import YandexBusinessMap from './YandexBusinessMap.astro';
import OnlineValuationQuiz from './OnlineValuationQuiz.astro';
import { landingSeoByFile } from '../data/seo';

interface Props {
  file: string;
  editorial?: boolean;
}

const { file, editorial = false } = Astro.props;
const showBusinessMap = file === 'page132437346.html';
const seo = landingSeoByFile[file];
const fileRoutes: Record<string, string> = {
  'page132437346.html': '/',
  'page136045756.html': '/buy_champagne',
  'page136045966.html': '/buy_whisky',
  'page136046316.html': '/buy_cognac',
  'page136046936.html': '/buy_portwine',
  'page136047606.html': '/buy_rum',
  'page136048186.html': '/buy_vodka',
  'page136049296.html': '/buy_brandy',
  'page136462246.html': '/buy_wine',
};

const heroRecordByFile: Record<string, string> = {
  'page132437346.html': 'rec2153096741',
  'page136045756.html': 'rec2183097071',
  'page136045966.html': 'rec2187393971',
  'page136046316.html': 'rec2187529151',
  'page136046936.html': 'rec2187641621',
  'page136047606.html': 'rec2187700811',
  'page136048186.html': 'rec2187722761',
  'page136049296.html': 'rec2187785841',
  'page136462246.html': 'rec2189792391',
};

// Which journal category each landing page belongs to, and how the category
// reads after "Статьи о ...".
const journalCategoryByFile: Record<string, { category: string; label: string }> = {
  'page136462246.html': { category: 'wine', label: 'вине' },
  'page136045756.html': { category: 'champagne', label: 'шампанском' },
  'page136045966.html': { category: 'whisky', label: 'виски' },
  'page136046316.html': { category: 'cognac', label: 'коньяке' },
  'page136046936.html': { category: 'portwine', label: 'портвейне' },
  'page136047606.html': { category: 'rum', label: 'роме' },
  'page136048186.html': { category: 'vodka', label: 'водке' },
  'page136049296.html': { category: 'brandy', label: 'бренди' },
};

const sectionRecordByFile: Record<string, string> = {
  'page132437346.html': 'rec2127258581',
  'page136045756.html': 'rec2186910541',
  'page136045966.html': 'rec2187315621',
  'page136046316.html': 'rec2187446001',
  'page136046936.html': 'rec2187546781',
  'page136047606.html': 'rec2187648331',
  'page136048186.html': 'rec2187723531',
  'page136049296.html': 'rec2187763411',
  'page136462246.html': 'rec2189803901',
};

const brandRailMarkup = (variant: 'hero' | 'section') =>
  `<div class="brand-rail brand-rail--${variant}" aria-hidden="true"><span class="brand-rail__line"></span><span class="brand-rail__copy"><span class="brand-rail__brand">ANDREWINE</span><small>Выкуп элитного алкоголя</small></span><span class="brand-rail__line"></span></div>`;

const injectBrandRail = (html: string, recordId: string, variant: 'hero' | 'section') =>
  html.replace(
    new RegExp(`(<div id="${recordId}")([^>]*>)`),
    `$1 data-brand-rail-host="${variant}"$2${brandRailMarkup(variant)}`,
  );

let source = readFileSync(path.join(process.cwd(), 'src', 'legacy', file), 'utf8');

source = source
  .replaceAll('https://xn--80aexbctj5a4e.xn--p1ai', 'https://andrewine.ru')
  .replaceAll('http://xn--80aexbctj5a4e.xn--p1ai', 'https://andrewine.ru')
  .replaceAll('https://алковыкуп.рф', 'https://andrewine.ru')
  .replaceAll('http://алковыкуп.рф', 'https://andrewine.ru');

// The export contains a second footer phone from the retired project. Remove
// that whole legacy element instead of replacing it and showing the current
// number twice. The active phone remains in the header, contact block, widget
// and the primary footer contact group.
source = source.replace(
  /<div class=['"]t396__elem[^>]*data-elem-id=['"]1776874730550000001['"][\s\S]*?<div class=['"]tn-atom['"][^>]*>[\s\S]*?<\/div>\s*<\/div>/gi,
  '',
);

// The exported Tilda pages contain a second, stale LocalBusiness entity for
// the retired brand "Алковыкуп". Keep the visible legacy markup for layout, but
// remove that JSON-LD block so search engines only receive Andrewine's current
// organization/service data from LandingSeoHead.
source = source.replace(
  /<script\s+type=["']application\/ld\+json["'][^>]*>[\s\S]*?(?:Алковыкуп|алковыкуп)[\s\S]*?<\/script>/gi,
  '',
);

// The same export also injects keyword-stuffed alt text from JavaScript. It is
// neither useful for users nor valid image descriptions, so remove it and keep
// the curated alts supplied by the page data/components.
source = source.replace(
  /<script>\s*document\.addEventListener\(['"]DOMContentLoaded['"],[\s\S]*?var\s+altMap=[\s\S]*?<\/script>/gi,
  '',
);
source = source.replace(
  /<script>\s*document\.addEventListener\(['"]DOMContentLoaded['"],[\s\S]*?var\s+alts=\s*\[[\s\S]*?setAttribute\(['"]alt['"][\s\S]*?<\/script>/gi,
  '',
);

// The original vertical experience badge is a small raster image and becomes
// visibly blurred after Tilda scales and rotates it. Keep the original layout,
// but replace both lazy-load URLs with a crisp, locally drawn SVG.
source = source
  .replaceAll('https://static.tildacdn.com/tild6164-6333-4835-a466-626266363438/Group_10.png', 'https://selkorin.github.io/andrewine/assets/experience-badge.svg')
  .replaceAll('https://thb.tildacdn.com/tild6164-6333-4835-a466-626266363438/-/resize/20x/Group_10.png', 'https://selkorin.github.io/andrewine/assets/experience-badge.svg');

for (const lineAsset of [
  'tild6364-3939-4137-b533-386662663831',
  'tild3930-3936-4337-a661-336165396539',
  'tild3237-3363-4836-a331-653463626463',
  'tild3366-3661-4630-b061-613364393634',
]) {
  source = source
    .replaceAll(`https://static.tildacdn.com/${lineAsset}/_.png`, 'https://selkorin.github.io/andrewine/assets/section-line.svg')
    .replaceAll(`https://thb.tildacdn.com/${lineAsset}/-/resize/20x/_.png`, 'https://selkorin.github.io/andrewine/assets/section-line.svg');
}

for (const [pageFile, route] of Object.entries(fileRoutes)) {
  source = source.replaceAll(pageFile, route);
}

// Tilda export contains duplicated closing tags and a fragment of an old SEO
// snippet outside <script>. Browsers render that fragment as `}}}})` and can
// leave the original Tilda records hidden. Remove only those broken leftovers.
source = source
  .replace(/<\/script>\s*\}\s*\}\s*\}\s*\}\s*\)\s*<\/script>/g, '</script>')
  .replaceAll('</script></script></style>', '</script>')
  .replaceAll('</script></script><!-- nominify end -->', '</script><!-- nominify end -->');

// Old exports create an off-screen H1 after DOMContentLoaded. The visible hero
// already contains the real H1, so keeping this script produces two primary
// headings in the rendered DOM even though a static HTML audit sees only one.
source = source.replace(
  /<script>document\.addEventListener\(['"]DOMContentLoaded['"],function\(\)\{var h=document\.createElement\(['"]h1['"]\);[\s\S]*?document\.body\.insertBefore\(h,document\.body\.firstChild\);\}\);<\/script>/gi,
  '',
);

// The retired /premium_alcohol route used to be sent to the home page here, which
// ran before rewriteLegacyLinks could point it at the journal — so the menu item
// reading "СТАТЬИ" landed on the home page. Leave the hrefs alone and let
// rewriteLegacyLinks map them to the articles index.

const legacyHead = source.match(/<head[^>]*>([\s\S]*?)<\/head>/i)?.[1] ?? '';
const cleanHead = legacyHead
  .replace(/<title>[\s\S]*?<\/title>/gi, '')
  .replace(/<meta[^>]+(?:name|property)=["'](?:description|robots|og:[^"']+|twitter:[^"']+)["'][^>]*>/gi, '')
  .replace(/<link[^>]+rel=["']canonical["'][^>]*>/gi, '')
  .replace(/<link[^>]+rel=["'](?:icon|apple-touch-icon)["'][^>]*>/gi, '');
const head = resolveTildaHead(cleanHead, file === 'page132437346.html' ? './' : '../');
const body = source.match(/<body[^>]*>([\s\S]*?)<\/body>/i)?.[1] ?? '';
const footerIndex = body.indexOf('<!--footer-->');
const root = file === 'page132437346.html' ? './' : '../';
let contentBeforeFooter = rewriteLegacyLinks(footerIndex >= 0 ? body.slice(0, footerIndex) : body, root);
// Drop the "Made on Tilda" badge that sits just after the footer.
const footerAndScripts = rewriteLegacyLinks(footerIndex >= 0 ? body.slice(footerIndex) : '', root)
  .replace(/<!--\s*Tilda copyright[\s\S]*?<div class="t-tildalabel[\s\S]*?<\/a><\/div>/, '');

// The Tilda header bar is replaced by our own, so drop its records from the body.
contentBeforeFooter = contentBeforeFooter.replace(/<!--header-->[\s\S]*?<!--\/header-->/, '');

const heroRecord = heroRecordByFile[file];
if (heroRecord) {
  contentBeforeFooter = injectBrandRail(contentBeforeFooter, heroRecord, 'hero');
}

const sectionRecord = sectionRecordByFile[file];
if (sectionRecord) {
  contentBeforeFooter = injectBrandRail(contentBeforeFooter, sectionRecord, 'section');
}

// Two categories ship the copy inside their Tilda export; the rest take it from
// data. Either way the accordion lands in the same place, just before the footer.
contentBeforeFooter = rebuildLegacyCategoryFaq(contentBeforeFooter);

const categoryFaq = categoryFaqs[file];
if (categoryFaq) {
  contentBeforeFooter += renderCategoryFaqFromData(categoryFaq.title, categoryFaq.items);
}

const journalCategory = journalCategoryByFile[file];
const journalIndex = Object.keys(journalCategoryByFile).indexOf(file);

// Tilda exports every image with alt="", including the main bottle photo.
// Keep decorative textures empty, but describe the principal category image.
const principalImageByFile: Record<string, string> = {
  'page132437346.html': 'tild3535-3164-4430-a135-326635636130/Mask_group.png',
  'page136045756.html': 'tild6563-3138-4333-b162-386333396239/__1.png',
  'page136045966.html': 'tild3461-3761-4065-b330-633464613932/__1.png',
  'page136046316.html': 'tild6339-6161-4239-b832-383733303766/2_1.png',
  'page136046936.html': 'tild3835-6461-4638-b534-666361326633/photo.png',
  'page136047606.html': 'tild6663-3730-4338-b133-623764313262/diplomatiko_1.png',
  'page136048186.html': 'tild3035-3566-4032-b235-353665353831/_1.png',
  'page136049296.html': 'tild3264-3533-4361-a466-616537623862/kkk_1.png',
  'page136462246.html': 'tild3231-3134-4737-a235-653231313864/ChatGPT_Image_21__20.png',
};

const principalImage = principalImageByFile[file];
if (seo && principalImage) {
  contentBeforeFooter = contentBeforeFooter.replace(
    new RegExp(`(<img\\b(?=[^>]*data-original=['"][^'"]*${principalImage.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}[^'"]*['"])[^>]*?)alt=(['"])\\2`, 'i'),
    `$1alt="${seo.imageAlt}"`,
  );
}

// Some responsive Tilda copies were exported as additional H1 elements.
// Preserve their styling and text but expose only one primary heading to crawlers.
let h1Seen = false;
let convertCurrentH1 = false;
contentBeforeFooter = contentBeforeFooter.replace(/<\/?h1\b[^>]*>/gi, (tag) => {
  if (/^<h1/i.test(tag)) {
    if (!h1Seen) { h1Seen = true; convertCurrentH1 = false; return tag; }
    convertCurrentH1 = true;
    return tag.replace(/^<h1/i, '<h2');
  }
  if (convertCurrentH1) {
    convertCurrentH1 = false;
    return tag.replace(/^<\/h1/i, '</h2');
  }
  return tag;
});

// On the home page the standalone online valuation quiz belongs directly
// after the visual "three steps" record. Split the raw legacy markup at the
// following technical record so Astro can render an accessible component in
// the exact position without changing the original form further down the page.
const quizInsertMarker = '<div id="rec2191281851"';
const quizInsertIndex = editorial ? contentBeforeFooter.indexOf(quizInsertMarker) : -1;
const contentBeforeQuiz = quizInsertIndex >= 0 ? contentBeforeFooter.slice(0, quizInsertIndex) : contentBeforeFooter;
const contentAfterQuiz = quizInsertIndex >= 0 ? contentBeforeFooter.slice(quizInsertIndex) : '';

---

<!doctype html>
<html lang="ru">
  <head>
    {seo && <LandingSeoHead seo={seo} />}
    <Fragment set:html={head} />
    <style is:inline set:html={resolveVendorPaths(enhancementsCss, root)} />
    <style is:global id="tilda-records-visibility-fix">.t-records{opacity:1!important}</style>
  </head>
  <body class:list={['t-body', 'legacy-page', { 'home-page': editorial }]} style="margin:0;">
    <YandexMetrika />
    <SiteHeader root={root} active={(fileRoutes[file] ?? '/').replace(/^\//, '') || undefined} />
    <Fragment set:html={contentBeforeQuiz} />
    {editorial && <OnlineValuationQuiz />}
    {showBusinessMap && <YandexBusinessMap />}
    <Fragment set:html={contentAfterQuiz} />
    {editorial && <SeoSections />}
    {journalCategory && <CategorySeoContent file={file} root={root} />}
    {journalCategory && <CategoryArticles category={journalCategory.category} label={journalCategory.label} root={root} index={journalIndex} />}
    <Fragment set:html={footerAndScripts} />
    <script is:inline>
      (() => {
        // Keep the original Tilda record intact, but promote the editorial
        // "Элитный алкоголь" bridge so it sits immediately above the journal.
        const editorialBridge = document.querySelector('#rec2127258581');
        const journal = document.querySelector('[data-home-journal]');
        if (editorialBridge && journal) journal.before(editorialBridge);

        // Opening an answer would otherwise grow the FAQ section and shove the
        // rest of the page down. Reserve the height of the tallest answer up
        // front, at every width, so expanding an item never moves the frame.
        document.querySelectorAll('.category-faq .home-faq__list').forEach((list) => {
          const items = Array.from(list.querySelectorAll('details'));
          if (!items.length) return;
          const reserveHeight = () => {
            list.style.height = 'auto';
            const openBefore = items.map((item) => item.open);
            items.forEach((item) => { item.open = false; });
            let tallest = list.offsetHeight;
            items.forEach((item) => {
              item.open = true;
              tallest = Math.max(tallest, list.offsetHeight);
              item.open = false;
            });
            items.forEach((item, index) => { item.open = openBefore[index]; });
            list.style.height = `${tallest}px`;
          };
          // Answer heights change as webfonts swap in and Tilda finishes laying
          // the page out, and a lock taken too early reserves too little. Re-run
          // on every signal that the layout may have settled.
          requestAnimationFrame(reserveHeight);
          document.fonts?.ready.then(reserveHeight);
          window.addEventListener('load', reserveHeight);
          window.addEventListener('resize', reserveHeight, { passive: true });
          [300, 1000, 2500].forEach((delay) => setTimeout(reserveHeight, delay));
        });

        document.querySelectorAll('[data-brand-rail-host="hero"]').forEach((host) => {
          const title = host.querySelector('.tn-elem[data-elem-id="1776083437912000010"] .tn-atom');
          if (title instanceof HTMLElement) {
            const echo = title.cloneNode(true);
            echo.querySelectorAll('br').forEach((br) => br.replaceWith('\n'));
            title.dataset.heroOutline = echo.textContent?.trim() ?? '';
          }
        });
        const alignBrandRails = () => {
          document.querySelectorAll('[data-brand-rail-host]').forEach((host) => {
            const variant = host.getAttribute('data-brand-rail-host');
            const rail = host.querySelector('.brand-rail');
            const redBandId = variant === 'hero' ? '1776082148255' : '1775516228225';
            const redBand = host.querySelector(`.tn-elem[data-elem-id="${redBandId}"]`);
            if (!(rail instanceof HTMLElement) || !(redBand instanceof HTMLElement)) return;
            const hostBox = host.getBoundingClientRect();
            const bandBox = redBand.getBoundingClientRect();
            const inset = Math.max(8, Math.min(22, bandBox.height * .04));
            const availableHeight = Math.max(0, bandBox.height - inset * 2);
            const railHeight = Math.min(availableHeight, bandBox.height * .8, hostBox.height * .6);
            const centeredTop = bandBox.top - hostBox.top + (bandBox.height - railHeight) / 2;
            rail.style.top = `${centeredTop}px`;
            rail.style.height = `${railHeight}px`;
            rail.dataset.aligned = 'true';
          });
        };
        requestAnimationFrame(alignBrandRails);
        window.addEventListener('load', alignBrandRails, { once: true });
        window.addEventListener('resize', alignBrandRails, { passive: true });
        if ('ResizeObserver' in window) {
          const observer = new ResizeObserver(alignBrandRails);
          document.querySelectorAll('[data-brand-rail-host]').forEach((host) => {
            observer.observe(host);
            const variant = host.getAttribute('data-brand-rail-host');
            const redBandId = variant === 'hero' ? '1776082148255' : '1775516228225';
            const redBand = host.querySelector(`.tn-elem[data-elem-id="${redBandId}"]`);
            if (redBand) observer.observe(redBand);
          });
        }
        document.fonts?.ready.then(alignBrandRails);
      })();
    </script>
    <script is:inline>
      (() => {
        const forms = document.querySelectorAll('form.t-form:has(input[type="file"])');

        forms.forEach((form) => {
          if (!(form instanceof HTMLFormElement) || form.dataset.adminLeadReady === 'true') return;
          form.dataset.adminLeadReady = 'true';

          const existingPhone = form.querySelector('input[name="Phone"], input[type="tel"]');
          const emailGroup = form.querySelector('.t-input-group_em');
          const phoneGroup = existingPhone ? null : emailGroup?.cloneNode(true);
          if (phoneGroup instanceof HTMLElement) {
            phoneGroup.classList.remove('t-input-group_em');
            phoneGroup.classList.add('t-input-group_ph');
            phoneGroup.dataset.fieldType = 'ph';
            phoneGroup.dataset.fieldName = 'Phone';
            const label = phoneGroup.querySelector('label');
            const input = phoneGroup.querySelector('input');
            const error = phoneGroup.querySelector('.t-input-error');
            if (label && input instanceof HTMLInputElement) {
              const id = `website_phone_${form.id || Math.random().toString(36).slice(2)}`;
              label.textContent = 'Телефон';
              label.setAttribute('for', id);
              input.id = id;
              input.type = 'tel';
              input.name = 'Phone';
              input.value = '';
              input.placeholder = '+7 (___) ___-__-__';
              input.autocomplete = 'tel';
              input.required = true;
              input.setAttribute('aria-required', 'true');
              input.removeAttribute('data-tilda-rule');
              if (error) error.id = `${id}_error`;
              emailGroup.insertAdjacentElement('afterend', phoneGroup);
            }
          }

          form.addEventListener('submit', async (event) => {
            event.preventDefault();
            event.stopImmediatePropagation();

            const submit = form.querySelector('button[type="submit"]');
            const success = form.querySelector('.js-successbox');
            const errorBox = form.querySelector('.js-errorbox-all');
            const phone = form.querySelector('input[name="Phone"]');
            const photos = form.querySelector('input[type="file"]');
            const phoneValue = phone instanceof HTMLInputElement ? phone.value.trim() : '';
            const files = photos instanceof HTMLInputElement ? Array.from(photos.files || []) : [];
            const digits = phoneValue.replace(/\D/g, '');

            const showError = (message) => {
              if (errorBox instanceof HTMLElement) {
                errorBox.style.display = 'block';
                const line = errorBox.querySelector('.js-rule-error-all');
                if (line) line.textContent = message;
              } else {
                window.alert(message);
              }
            };

            if (digits.length < 10) {
              showError('Укажите корректный телефон');
              phone?.focus();
              return;
            }
            if (!files.length || files.length > 10) {
              showError('Добавьте от 1 до 10 фотографий');
              return;
            }

            const payload = new FormData();
            const name = form.querySelector('input[name="Name"]');
            const email = form.querySelector('input[name="Email"]');
            const message = form.querySelector('textarea');
            payload.set('phone', phoneValue);
            payload.set('name', name instanceof HTMLInputElement ? name.value.trim() : '');
            payload.set('email', email instanceof HTMLInputElement ? email.value.trim() : '');
            payload.set('message', message instanceof HTMLTextAreaElement ? message.value.trim() : '');
            payload.set('source', window.location.href);
            payload.set('category', document.querySelector('h1')?.textContent?.trim() || 'Элитный алкоголь');
            payload.set('website', '');
            files.forEach((file) => payload.append('photos', file, file.name));

            if (submit instanceof HTMLButtonElement) {
              submit.disabled = true;
              submit.setAttribute('aria-busy', 'true');
              const text = submit.querySelector('.t-btnflex__text');
              if (text) text.textContent = 'Отправляем…';
            }
            if (errorBox instanceof HTMLElement) errorBox.style.display = 'none';

            try {
              const response = await fetch('/api/applications/web', { method: 'POST', body: payload });
              if (!response.ok) {
                const result = await response.json().catch(() => null);
                throw new Error(result?.detail || 'Не удалось отправить заявку');
              }
              form.reset();
              const inputs = form.querySelector('.t-form__inputsbox');
              if (inputs instanceof HTMLElement) inputs.style.display = 'none';
              if (success instanceof HTMLElement) {
                success.textContent = 'Спасибо! Заявка и фотографии переданы оценщику. Мы свяжемся с вами.';
                success.style.display = 'block';
              }
              if (typeof window.ym === 'function') window.ym(113109306, 'reachGoal', 'lead_submit');
            } catch (error) {
              showError(error instanceof Error ? error.message : 'Не удалось отправить заявку');
              if (submit instanceof HTMLButtonElement) {
                submit.disabled = false;
                submit.removeAttribute('aria-busy');
                const text = submit.querySelector('.t-btnflex__text');
                if (text) text.textContent = 'Отправить';
              }
            }
          }, true);
        });
      })();
    </script>
  </body>
</html>
