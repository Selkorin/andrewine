---
import { getTildaHeadAssets } from '../lib/legacyChrome';

const tildaAssets = getTildaHeadAssets();
---

<link rel="preconnect" href="https://fonts.gstatic.com" />
<script is:inline>if(!location.pathname.endsWith('/')&&!/\.[a-z0-9]+$/i.test(location.pathname))history.replaceState(null,'',location.pathname+'/'+location.search+location.hash);</script>
<Fragment set:html={tildaAssets} />
