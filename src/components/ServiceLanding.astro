---
import SiteHeader from './SiteHeader.astro';
import CleanFooter from './CleanFooter.astro';
import OnlineValuationQuiz from './OnlineValuationQuiz.astro';
import YandexMetrika from './YandexMetrika.astro';
import YandexBusinessMap from './YandexBusinessMap.astro';
import { categories, contacts } from '../data/navigation';
import { landingSeoByFile } from '../data/seo';
import { serviceLandingByFile } from '../data/serviceLandings';

interface Props { file: string }
const { file } = Astro.props;
const seo = landingSeoByFile[file];
const data = serviceLandingByFile[file];
const isHome = seo.route === '/';
const root = isHome ? './' : '../';
const canonical = new URL(isHome ? '/' : `${seo.route}/`, 'https://andrewine.ru').href;
const schema = { '@context':'https://schema.org', '@graph': [
  { '@type':['Organization','ProfessionalService'], '@id':'https://andrewine.ru/#organization', name:'Andrewine', url:'https://andrewine.ru/', telephone:'+7-986-345-82-35', email:'andrewine@mail.com', areaServed:['Москва','Московская область'] },
  { '@type':'WebSite', '@id':'https://andrewine.ru/#website', name:'Andrewine', url:'https://andrewine.ru/', inLanguage:'ru-RU', publisher:{ '@id':'https://andrewine.ru/#organization' } },
  { '@type':'WebPage', '@id':`${canonical}#webpage`, name:seo.title, description:seo.description, url:canonical, inLanguage:'ru-RU', isPartOf:{ '@id':'https://andrewine.ru/#website' }, about:{ '@id':`${canonical}#service` } },
  { '@type':'Service', '@id':`${canonical}#service`, name:seo.service, description:seo.description, url:canonical, provider:{ '@id':'https://andrewine.ru/#organization' }, areaServed:['Москва','Московская область'] },
  ...(!isHome ? [{ '@type':'BreadcrumbList', '@id':`${canonical}#breadcrumb`, itemListElement:[
    { '@type':'ListItem', position:1, name:'Главная', item:'https://andrewine.ru/' },
    { '@type':'ListItem', position:2, name:seo.heading, item:canonical },
  ] }] : []),
] };
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="google-site-verification" content="bB-97hnC8t1scNC8LHZQBxFpgWhkiEARR5obA0sH8zU" />
    <title>{seo.title}</title><meta name="description" content={seo.description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" /><link rel="canonical" href={canonical} />
    <meta property="og:locale" content="ru_RU" /><meta property="og:type" content="website" /><meta property="og:site_name" content="Andrewine" />
    <meta property="og:title" content={seo.title} /><meta property="og:description" content={seo.description} /><meta property="og:url" content={canonical} /><meta property="og:image" content="https://andrewine.ru/assets/ocenka-og.png" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="theme-color" content="#79000c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;1,500&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <YandexMetrika />
    <a class="skip-link" href="#content">К содержанию</a>
    <SiteHeader root={root} active={data.slug} />
    <main id="content">
      <section class:list={['clean-hero',{'clean-hero--home':isHome}]}>
        <div class="clean-hero__copy">
          <p class="kicker">{data.eyebrow}</p><h1>{seo.heading}</h1><p class="clean-hero__lead">{data.intro}</p>
          <div class="clean-hero__actions"><a class="button" href="#online-valuation">Оценить по фото</a><a class="text-link" href={contacts.phoneHref}>Позвонить эксперту</a>{isHome && <a class="text-link" href="./sell-alcohol/">Продать алкоголь</a>}</div>
          <div class="clean-hero__facts"><span><b>С 2014 года</b> работаем с частными коллекциями</span><span><b>15 минут</b> на предварительную оценку</span><span><b>Конфиденциально</b> без публикации данных</span></div>
        </div>
        <div class="clean-hero__visual"><div class="clean-hero__halo"></div><img src={data.image} alt={data.imageAlt} width="760" height="860" fetchpriority="high" /></div>
      </section>

      {isHome && <section class="category-section"><div class="section-heading"><p class="kicker">Направления</p><h2>Что мы оцениваем</h2><p>Каждую категорию проверяем по своим признакам: винтажу, релизу, состоянию и подтверждённому спросу.</p></div><div class="category-list">{categories.map(([label,slug],index)=><a href={`./${slug}/`}><span>0{index+1}</span><b>{label}</b><i>Подробнее →</i></a>)}</div></section>}

      <section class="expertise"><div class="section-heading"><p class="kicker">Предмет оценки</p><h2>{isHome ? 'Редкие бутылки и целые коллекции' : `Какие позиции ${data.label.toLowerCase()} рассматриваем`}</h2></div><ul>{data.examples.map((item,index)=><li><span>0{index+1}</span>{item}</li>)}</ul></section>

      <section class="factors"><div class="section-heading"><p class="kicker">Экспертный подход</p><h2>От чего зависит предложение</h2></div><div class="factor-grid">{data.factors.map((factor,index)=><article><span>0{index+1}</span><h3>{factor.title}</h3><p>{factor.text}</p></article>)}</div></section>

      <section class="appraisal-visual"><div class="appraisal-visual__copy"><p class="kicker">Визуальная экспертиза</p><h2>Смотрим на бутылку целиком</h2><p>Для точной оценки важны не только бренд и год. Мы сверяем состояние, комплектность, происхождение и актуальный спрос на редкие выпуски.</p></div><img src="/assets/infographic-appraisal.png" alt={`Экспертная оценка: ${data.label.toLowerCase()}, состояние бутылки и комплектность`} width="1536" height="1024" loading="lazy" /></section>

      <section class="process"><div><p class="kicker">Как это работает</p><h2>От фотографий до расчёта</h2></div><ol><li><b>Отправьте фото</b><span>Общий вид, этикетки, пробка, уровень и упаковка.</span></li><li><b>Получите оценку</b><span>Сверим выпуск, состояние и текущий спрос.</span></li><li><b>Согласуйте встречу</b><span>Эксперт осмотрит бутылку и подтвердит предложение.</span></li><li><b>Получите расчёт</b><span>Фиксируем условия после проверки.</span></li></ol></section>

      <OnlineValuationQuiz />
      <YandexBusinessMap />

      <section class="trust" id="about"><div><p class="kicker">Andrewine</p><h2>Специализация вместо массовой скупки</h2></div><div><p>Работаем с редкими напитками и частными коллекциями. Не называем цену только по названию бренда: сначала определяем точный выпуск и проверяем состояние.</p><p>Предварительная оценка бесплатна. Финальное предложение подтверждаем после осмотра бутылки и комплекта.</p></div></section>
    </main>
    <CleanFooter root={root} />
  </body>
</html>

<style is:global>
  :root{--wine:#79000c;--wine-bright:#b20b1d;--ink:#251416;--paper:#f3ede4;--cream:#e8ddd1;--black:#080505;--line:rgba(45,21,22,.16)}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Manrope,Arial,sans-serif}a{color:inherit;text-decoration:none}.skip-link{position:fixed;z-index:1200;left:16px;top:-60px;background:#fff;padding:12px}.skip-link:focus{top:12px}.kicker{margin:0 0 18px;color:var(--wine-bright);font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase}.clean-hero{min-height:760px;padding:150px max(24px,calc((100vw - 1280px)/2)) 80px;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:48px;background:radial-gradient(circle at 77% 32%,rgba(164,0,19,.34),transparent 27%),linear-gradient(115deg,#080505,#18090b 58%,#080505);color:#fff;overflow:hidden}.clean-hero__copy{position:relative;z-index:2}.clean-hero h1{max-width:780px;margin:0;font:500 clamp(54px,6vw,88px)/.96 'Playfair Display',Georgia,serif;letter-spacing:-.045em;text-wrap:balance}.clean-hero__lead{max-width:670px;margin:28px 0 0;color:#d7cac9;font-size:19px;line-height:1.65}.clean-hero__actions{display:flex;align-items:center;gap:28px;margin-top:34px}.button{display:inline-flex;justify-content:center;padding:17px 26px;border-radius:10px;background:var(--wine-bright);color:#fff;font-weight:700;transition:.2s}.button:hover{transform:translateY(-2px);background:#c10b20}.text-link{padding-bottom:5px;border-bottom:1px solid rgba(255,255,255,.4);font-weight:600}.clean-hero__facts{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:58px;padding-top:22px;border-top:1px solid rgba(255,255,255,.16);color:#988c8c;font-size:12px;line-height:1.5}.clean-hero__facts b{display:block;color:#fff;font-size:14px}.clean-hero__visual{position:relative;height:580px;display:grid;place-items:center}.clean-hero__visual img{position:relative;z-index:1;width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 34px 46px rgba(0,0,0,.5))}.clean-hero--home .clean-hero__visual img{object-fit:cover;opacity:.48;mask-image:linear-gradient(to bottom,#000 60%,transparent)}.clean-hero__halo{position:absolute;width:min(34vw,480px);aspect-ratio:1;border:1px solid rgba(255,255,255,.12);border-radius:50%;box-shadow:0 0 0 55px rgba(255,255,255,.025),0 0 0 110px rgba(255,255,255,.016)}.section-heading{max-width:660px}.section-heading h2,.process h2,.trust h2{margin:0;font:500 clamp(42px,4.5vw,66px)/1.02 'Playfair Display',Georgia,serif;letter-spacing:-.035em;text-wrap:balance}.section-heading>p:last-child{color:#766967;line-height:1.7}.category-section,.expertise,.factors,.process,.trust{padding:100px max(24px,calc((100vw - 1280px)/2))}.category-list{display:grid;grid-template-columns:repeat(4,1fr);margin-top:48px;border-top:1px solid var(--line);border-left:1px solid var(--line)}.category-list a{min-height:180px;padding:24px;display:flex;flex-direction:column;border-right:1px solid var(--line);border-bottom:1px solid var(--line);transition:.2s}.category-list a:hover{background:#fff;transform:translateY(-3px)}.category-list span,.factor-grid>article>span{color:#a49791;font-size:12px}.category-list b{margin-top:auto;font:500 26px 'Playfair Display',serif}.category-list i{margin-top:10px;color:var(--wine);font-size:12px;font-style:normal}.expertise{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;background:#fff}.expertise ul{margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;list-style:none;border-top:1px solid var(--line)}.expertise li{display:flex;gap:15px;padding:23px 10px;border-bottom:1px solid var(--line);font-size:17px}.expertise li span{color:var(--wine);font-size:11px}.factors{background:var(--paper)}.factor-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:50px}.factor-grid article{min-height:280px;padding:30px;background:#fff}.factor-grid h3{margin:72px 0 12px;font:500 27px 'Playfair Display',serif}.factor-grid p{color:#746766;line-height:1.65}.process{display:grid;grid-template-columns:.7fr 1.3fr;gap:90px;background:var(--wine);color:#fff}.process .kicker{color:#fff}.process ol{margin:0;padding:0;list-style:none;counter-reset:step}.process li{display:grid;grid-template-columns:200px 1fr;gap:30px;padding:24px 0;border-top:1px solid rgba(255,255,255,.24)}.process li:last-child{border-bottom:1px solid rgba(255,255,255,.24)}.process li span{color:#eadadb;line-height:1.55}.trust{display:grid;grid-template-columns:1fr 1fr;gap:80px;background:#fff}.trust>div:last-child{padding-top:28px;color:#716565;font-size:18px;line-height:1.75}@media(max-width:900px){.clean-hero{grid-template-columns:1fr;padding-top:125px}.clean-hero__visual{height:360px}.category-list{grid-template-columns:repeat(2,1fr)}.expertise,.process,.trust{grid-template-columns:1fr;gap:42px}.factor-grid{grid-template-columns:1fr}.process li{grid-template-columns:1fr;gap:8px}}@media(max-width:600px){.clean-hero{padding-inline:18px;min-height:0}.clean-hero h1{font-size:49px}.clean-hero__facts{grid-template-columns:1fr}.clean-hero__visual{height:300px}.clean-hero__actions{align-items:flex-start;flex-direction:column}.category-section,.expertise,.factors,.process,.trust{padding:72px 18px}.category-list{grid-template-columns:1fr 1fr}.category-list a{min-height:145px;padding:18px}.expertise ul{grid-template-columns:1fr}.section-heading h2,.process h2,.trust h2{font-size:42px}}
</style>
<style is:global>
.appraisal-visual{display:grid;grid-template-columns:.72fr 1.28fr;gap:70px;align-items:center;padding:100px max(24px,calc((100vw - 1280px)/2));background:#ebe2d8}.appraisal-visual__copy h2{margin:0;font:500 clamp(42px,4.5vw,66px)/1.02 'Playfair Display',Georgia,serif;letter-spacing:-.035em}.appraisal-visual__copy>p:last-child{margin-top:24px;color:#716565;font-size:17px;line-height:1.7}.appraisal-visual img{display:block;width:100%;height:auto;border-radius:4px;box-shadow:0 22px 50px rgba(52,28,24,.15)}
@media(max-width:900px){.appraisal-visual{grid-template-columns:1fr;gap:36px;padding:72px 24px}}
</style>
