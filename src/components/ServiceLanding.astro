---
import SiteHeader from './SiteHeader.astro';
import CleanFooter from './CleanFooter.astro';
import OnlineValuationQuiz from './OnlineValuationQuiz.astro';
import YandexMetrika from './YandexMetrika.astro';
import YandexBusinessMap from './YandexBusinessMap.astro';
import { BottleWine, ChartNoAxesCombined, CircleDotDashed, PackageCheck, PackageOpen, ScanSearch, ScanText } from '@lucide/astro';
import { categories, contacts } from '../data/navigation';
import { landingSeoByFile } from '../data/seo';
import { serviceLandingByFile } from '../data/serviceLandings';

interface Props { file: string }
const { file } = Astro.props;
const seo = landingSeoByFile[file];
const data = serviceLandingByFile[file];
const isHome = seo.route === '/';
const root = isHome ? './' : '../';
const canonical = new URL(isHome ? '/' : `${seo.route}/`, 'https://andrewine.ru').href;
const categoryImageBySlug: Record<string, string> = {
  buy_wine: '/assets/category-wine.webp', buy_champagne: '/assets/category-champagne.webp',
  buy_whisky: '/assets/category-whisky.webp', buy_cognac: '/assets/category-cognac.webp',
  buy_portwine: '/assets/category-portwine.webp', buy_rum: '/assets/category-rum.webp',
  buy_vodka: '/assets/category-vodka.webp', buy_brandy: '/assets/category-brandy.webp',
};
const schema = { '@context':'https://schema.org', '@graph': [
  { '@type':['Organization','ProfessionalService'], '@id':'https://andrewine.ru/#organization', name:'Andrewine', url:'https://andrewine.ru/', telephone:'+79804669190', email:'andrewine@mail.com', areaServed:['Москва','Московская область'] },
  { '@type':'WebSite', '@id':'https://andrewine.ru/#website', name:'Andrewine', url:'https://andrewine.ru/', inLanguage:'ru-RU', publisher:{ '@id':'https://andrewine.ru/#organization' } },
  { '@type':'WebPage', '@id':`${canonical}#webpage`, name:seo.title, description:seo.description, url:canonical, inLanguage:'ru-RU', isPartOf:{ '@id':'https://andrewine.ru/#website' }, about:{ '@id':`${canonical}#service` } },
  { '@type':'Service', '@id':`${canonical}#service`, name:seo.service, description:seo.description, url:canonical, provider:{ '@id':'https://andrewine.ru/#organization' }, areaServed:['Москва','Московская область'] },
  ...(!isHome ? [{ '@type':'BreadcrumbList', '@id':`${canonical}#breadcrumb`, itemListElement:[
    { '@type':'ListItem', position:1, name:'Главная', item:'https://andrewine.ru/' },
    { '@type':'ListItem', position:2, name:seo.heading, item:canonical },
  ] }] : []),
] };
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="google-site-verification" content="bB-97hnC8t1scNC8LHZQBxFpgWhkiEARR5obA0sH8zU" />
    <title>{seo.title}</title><meta name="description" content={seo.description} />
    <meta name="robots" content="index,follow,max-image-preview:large,max-snippet:-1" /><link rel="canonical" href={canonical} />
    <meta property="og:locale" content="ru_RU" /><meta property="og:type" content="website" /><meta property="og:site_name" content="Andrewine" />
    <meta property="og:title" content={seo.title} /><meta property="og:description" content={seo.description} /><meta property="og:url" content={canonical} /><meta property="og:image" content="https://andrewine.ru/assets/ocenka-og.png" />
    <meta name="twitter:card" content="summary_large_image" /><meta name="theme-color" content="#79000c" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,500;1,500&display=swap" rel="stylesheet" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <YandexMetrika />
    <a class="skip-link" href="#content">К содержанию</a>
    <SiteHeader root={root} active={data.slug} />
    <main id="content">
      <section class:list={['clean-hero',{'clean-hero--home':isHome}]}>
        <div class="clean-hero__copy">
          <p class="kicker">{data.eyebrow}</p><h1>{seo.heading}</h1><p class="clean-hero__lead">{data.intro}</p>
          <div class="clean-hero__actions"><a class="button" href="#online-valuation">Оценить по фото</a><a class="text-link" href={contacts.phoneHref}>Позвонить эксперту</a>{isHome && <a class="text-link" href="./sell-alcohol/">Продать алкоголь</a>}</div>
          <div class="clean-hero__facts"><span><b>С 2014 года</b> работаем с частными коллекциями</span><span><b>15 минут</b> на предварительную оценку</span><span><b>Конфиденциально</b> без публикации данных</span></div>
        </div>
        <div class="clean-hero__visual"><div class="clean-hero__halo"></div><img src={data.image} alt={data.imageAlt} width="1000" height="1400" fetchpriority="high" /></div>
      </section>

      {isHome && <section class="category-section">
        <div class="section-heading section-heading--light"><p class="kicker">Частная коллекция</p><h2>Что мы оцениваем</h2><p>Каждую категорию проверяем по своим признакам: винтажу, релизу, состоянию и подтверждённому спросу.</p></div>
        <div class="category-list">{categories.map(([label,slug])=><a href={`./${slug}/`}><img src={categoryImageBySlug[slug]} alt="" loading="lazy" width="520" height="620" /><span class="category-list__shade"></span><b>{label}</b><i>Смотреть направление <span aria-hidden="true">↗</span></i></a>)}</div>
      </section>}

      <section class:list={['expertise',{'expertise--home':isHome}]}>
        <div class="section-heading"><p class="kicker">Предмет оценки</p><h2>{isHome ? 'Редкие бутылки и целые коллекции' : `Какие позиции ${data.label.toLowerCase()} рассматриваем`}</h2></div>
        <ul>{data.examples.map((item)=><li><span aria-hidden="true"></span>{item}</li>)}</ul>
      </section>

      <section class:list={['factors',{'factors--home':isHome}]}>
        <div class:list={['section-heading',{'section-heading--light':isHome}]}><p class="kicker">Экспертный подход</p><h2>От чего зависит предложение</h2></div>
        <div class="factor-grid">{data.factors.map((factor,index)=><article>
          <div class="factor-grid__visual" aria-hidden="true">
            {index === 0 && <ScanSearch />} {index === 1 && <PackageCheck />} {index === 2 && <ChartNoAxesCombined />}
            <span>{index === 0 ? 'Выпуск и подлинность' : index === 1 ? 'Сохранность и комплект' : 'Рынок коллекционеров'}</span>
          </div>
          <h3>{factor.title}</h3><p>{factor.text}</p>
        </article>)}</div>
      </section>

      {isHome ? <section class="photo-guide">
        <div class="photo-guide__heading"><p class="kicker">Фотографии для оценки</p><h2>Что нужно сфотографировать</h2><p>Пришлите несколько снимков при дневном свете: общий вид бутылки, этикетку, пробку и комплект. Не используйте фильтры — эксперту важны реальный цвет, уровень напитка и следы хранения.</p></div>
        <div class="photo-guide__grid">
          <article><div class="photo-guide__visual" aria-hidden="true"><span class="photo-guide__frame"></span><BottleWine /><i>Целиком в кадре</i></div><b>Бутылка целиком</b><span>Форма, уровень напитка и общий вид</span></article>
          <article><div class="photo-guide__visual" aria-hidden="true"><span class="photo-guide__frame"></span><ScanText /><i>Ровно, без бликов</i></div><b>Этикетка крупно</b><span>Название, винтаж и заводская маркировка</span></article>
          <article><div class="photo-guide__visual" aria-hidden="true"><span class="photo-guide__frame"></span><CircleDotDashed /><i>Сверху и сбоку</i></div><b>Пробка и капсула</b><span>Пломба, фольга и следы хранения</span></article>
          <article><div class="photo-guide__visual" aria-hidden="true"><span class="photo-guide__frame"></span><PackageOpen /><i>Разложите рядом</i></div><b>Коробка и комплект</b><span>Футляр, документы и аксессуары</span></article>
        </div>
      </section> : <section class="appraisal-visual"><div class="appraisal-visual__copy"><p class="kicker">Визуальная экспертиза</p><h2>Смотрим на бутылку целиком</h2><p>Для точной оценки важны не только бренд и год. Мы сверяем состояние, комплектность, происхождение и актуальный спрос на редкие выпуски.</p></div><img src="/assets/infographic-appraisal.png" alt={`Экспертная оценка: ${data.label.toLowerCase()}, состояние бутылки и комплектность`} width="1536" height="1024" loading="lazy" /></section>}

      <section class:list={['process',{'process--home':isHome}]}><div><p class="kicker">Как это работает</p><h2>От фотографий до расчёта</h2></div><ol><li><b>Отправьте фото</b><span>Общий вид, этикетки, пробка, уровень и упаковка.</span></li><li><b>Получите оценку</b><span>Сверим выпуск, состояние и текущий спрос.</span></li><li><b>Согласуйте встречу</b><span>Эксперт осмотрит бутылку и подтвердит предложение.</span></li><li><b>Получите расчёт</b><span>Фиксируем условия после проверки.</span></li></ol></section>

      <OnlineValuationQuiz />
      <YandexBusinessMap />

      <section class:list={['trust',{'trust--home':isHome}]} id="about"><div><p class="kicker">Andrewine</p><h2>Специализация вместо массовой скупки</h2></div><div><p>Работаем с редкими напитками и частными коллекциями. Не называем цену только по названию бренда: сначала определяем точный выпуск и проверяем состояние.</p><p>Предварительная оценка бесплатна. Финальное предложение подтверждаем после осмотра бутылки и комплекта.</p></div></section>
    </main>
    <CleanFooter root={root} />
  </body>
</html>

<style is:global>
  :root{--wine:#79000c;--wine-bright:#b20b1d;--ink:#251416;--paper:#f1eae1;--cream:#e8ddd1;--black:#080607;--charcoal:#151112;--smoke:#a69d99;--line:rgba(45,21,22,.16)}
  *{box-sizing:border-box}html{scroll-behavior:smooth;overflow-x:hidden}body{margin:0;background:var(--paper);color:var(--ink);font-family:Manrope,Arial,sans-serif;overflow-x:hidden}a{color:inherit;text-decoration:none}.skip-link{position:fixed;z-index:1200;left:16px;top:-60px;background:#fff;padding:12px}.skip-link:focus{top:12px}.kicker{margin:0 0 18px;color:#c7192d;font-size:12px;font-weight:700;letter-spacing:.2em;text-transform:uppercase}
  .clean-hero{position:relative;min-height:790px;padding:150px max(24px,calc((100vw - 1280px)/2)) 80px;display:grid;grid-template-columns:1.08fr .92fr;align-items:center;gap:48px;background:radial-gradient(circle at 77% 32%,rgba(164,0,19,.3),transparent 27%),linear-gradient(115deg,#080505,#18090b 58%,#080505);color:#fff;overflow:hidden}.clean-hero--home{min-height:860px;background-image:linear-gradient(90deg,rgba(4,3,3,.98) 0%,rgba(7,4,5,.91) 46%,rgba(7,4,5,.38) 75%,rgba(7,4,5,.7) 100%),url('/assets/ocenka-hero-cellar-bw-v5.webp');background-size:cover;background-position:center}.clean-hero__copy{position:relative;z-index:2;min-width:0}.clean-hero h1{max-width:780px;margin:0;font:500 clamp(54px,6vw,88px)/.96 'Playfair Display',Georgia,serif;letter-spacing:-.045em;text-wrap:balance;overflow-wrap:break-word}.clean-hero__lead{max-width:670px;margin:28px 0 0;color:#d7cac9;font-size:19px;line-height:1.65}.clean-hero__actions{display:flex;align-items:center;gap:28px;margin-top:34px}.button{display:inline-flex;justify-content:center;padding:17px 26px;border-radius:4px;background:var(--wine-bright);color:#fff;font-weight:700;transition:transform .2s,background .2s}.button:hover{transform:translateY(-2px);background:#c10b20}.text-link{padding-bottom:5px;border-bottom:1px solid rgba(255,255,255,.4);font-weight:600}.clean-hero__facts{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:58px;padding-top:22px;border-top:1px solid rgba(255,255,255,.16);color:#988c8c;font-size:12px;line-height:1.5}.clean-hero__facts b{display:block;color:#fff;font-size:14px}.clean-hero__visual{position:relative;height:600px;display:grid;place-items:center}.clean-hero__visual img{position:relative;z-index:1;width:100%;height:100%;object-fit:contain;filter:drop-shadow(0 34px 46px rgba(0,0,0,.62))}.clean-hero--home .clean-hero__visual img{width:min(92%,560px);height:96%;object-fit:contain;opacity:1;transform:translateY(24px)}.clean-hero__halo{position:absolute;width:min(34vw,480px);aspect-ratio:1;border:1px solid rgba(255,255,255,.12);border-radius:50%;box-shadow:0 0 0 55px rgba(255,255,255,.025),0 0 0 110px rgba(255,255,255,.016)}
  .section-heading{max-width:660px}.section-heading h2,.process h2,.trust h2,.photo-guide h2{margin:0;font:500 clamp(42px,4.5vw,66px)/1.02 'Playfair Display',Georgia,serif;letter-spacing:-.035em;text-wrap:balance}.section-heading>p:last-child{color:#766967;line-height:1.7}.section-heading--light h2{color:#fff}.section-heading--light>p:last-child{color:#bcb2af}
  .category-section,.expertise,.factors,.process,.trust,.photo-guide{padding:110px max(24px,calc((100vw - 1280px)/2))}.category-section{position:relative;background:linear-gradient(rgba(8,6,7,.86),rgba(8,6,7,.94)),url('/assets/home-cellar-categories-v2.webp') center/cover fixed;color:#fff}.category-section:before{content:"";position:absolute;inset:0;background:linear-gradient(90deg,rgba(121,0,12,.16),transparent 40%);pointer-events:none}.category-section>*{position:relative}.category-list{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin-top:54px;background:rgba(255,255,255,.13);border:1px solid rgba(255,255,255,.13)}.category-list a{position:relative;min-height:330px;padding:26px;display:flex;flex-direction:column;justify-content:flex-end;overflow:hidden;background:rgba(8,6,7,.58);isolation:isolate;transition:background .25s,transform .25s}.category-list a:hover{z-index:2;background:rgba(24,8,10,.35);transform:translateY(-5px)}.category-list img{position:absolute;z-index:-2;inset:22px 12px 64px;width:calc(100% - 24px);height:calc(100% - 86px);object-fit:contain;object-position:center bottom;filter:drop-shadow(0 22px 22px rgba(0,0,0,.5));transition:transform .35s,filter .35s}.category-list a:hover img{transform:scale(1.045);filter:drop-shadow(0 24px 28px rgba(0,0,0,.7))}.category-list__shade{position:absolute;z-index:-1;inset:0;background:linear-gradient(180deg,transparent 32%,rgba(7,5,6,.22) 54%,rgba(7,5,6,.96) 88%)}.category-list b{font:500 28px 'Playfair Display',serif}.category-list i{display:flex;justify-content:space-between;align-items:center;margin-top:10px;color:#d71324;font-size:12px;font-style:normal}
  .expertise{display:grid;grid-template-columns:.8fr 1.2fr;gap:80px;background:#fff}.expertise ul{margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;list-style:none;border-top:1px solid var(--line)}.expertise li{display:flex;gap:15px;padding:23px 10px;border-bottom:1px solid var(--line);font-size:17px}.expertise li>span{width:7px;height:7px;margin-top:8px;flex:0 0 auto;border:1px solid var(--wine);transform:rotate(45deg)}.expertise--home{position:relative;min-height:660px;align-items:end;background:linear-gradient(90deg,rgba(7,6,6,.95),rgba(7,6,6,.68) 50%,rgba(7,6,6,.5)),url('/assets/home-collection-table-v2.webp') center/cover;color:#fff}.expertise--home .section-heading{align-self:center}.expertise--home ul{padding:20px 28px;background:rgba(9,7,7,.62);border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(8px)}.expertise--home li{border-color:rgba(255,255,255,.18);color:#f4ede8}
  .factors{background:var(--paper)}.factor-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px;margin-top:50px}.factor-grid article{min-height:330px;padding:30px;background:#fff}.factor-grid__visual{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-bottom:25px;border-bottom:1px solid var(--line)}.factor-grid__visual svg{width:58px;height:58px;fill:none;stroke:var(--wine);stroke-width:1.35}.factor-grid__visual span{max-width:150px;color:var(--wine);font-size:10px;font-weight:700;letter-spacing:.12em;line-height:1.45;text-align:right;text-transform:uppercase}.factor-grid h3{margin:55px 0 12px;font:500 27px 'Playfair Display',serif}.factor-grid p{color:#746766;line-height:1.65}.factors--home{position:relative;background:linear-gradient(rgba(8,6,7,.74),rgba(8,6,7,.88)),url('/assets/home-expert-details-v2.webp') center/cover;color:#fff}.factors--home .factor-grid article{min-height:390px;display:flex;flex-direction:column;justify-content:flex-end;background:linear-gradient(180deg,rgba(18,14,15,.18),rgba(18,14,15,.82));border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(4px)}.factors--home .factor-grid__visual{margin-bottom:auto;border-color:rgba(255,255,255,.18)}.factors--home .factor-grid__visual svg{stroke:#d71324}.factors--home .factor-grid__visual span{color:#fff}.factors--home .factor-grid h3{margin:42px 0 12px;color:#fff}.factors--home .factor-grid p{color:rgba(255,255,255,.76)}
  .photo-guide{position:relative;display:grid;grid-template-columns:.75fr 1.25fr;gap:82px;background-image:linear-gradient(90deg,rgba(8,6,7,.92),rgba(8,6,7,.84)),url('/assets/ocenka-cellar-faq-v2.webp');background-position:center;background-size:cover;background-attachment:fixed;color:#fff}.photo-guide:before{content:"";position:absolute;inset:0;background:radial-gradient(circle at 18% 22%,rgba(121,0,12,.3),transparent 32%);pointer-events:none}.photo-guide>*{position:relative}.photo-guide__heading>p:last-child{margin-top:24px;color:rgba(255,255,255,.78);line-height:1.75}.photo-guide__grid{display:grid;grid-template-columns:1fr 1fr;gap:1px;background:rgba(255,255,255,.16);border:1px solid rgba(255,255,255,.16);box-shadow:0 28px 70px rgba(0,0,0,.36)}.photo-guide article{min-height:300px;padding:22px;display:flex;flex-direction:column;background:rgba(9,7,8,.82);backdrop-filter:blur(4px)}.photo-guide__visual{position:relative;min-height:152px;display:grid;place-items:center;margin-bottom:24px;background:radial-gradient(circle,rgba(121,0,12,.26),transparent 62%);overflow:hidden}.photo-guide__visual>svg{width:76px;height:76px;fill:none;stroke:#fff;stroke-width:1.25;filter:drop-shadow(0 12px 18px rgba(0,0,0,.4))}.photo-guide__frame{position:absolute;inset:8px;border:1px solid rgba(255,255,255,.24)}.photo-guide__frame:before,.photo-guide__frame:after{content:"";position:absolute;width:28px;height:28px;border-color:#d71324}.photo-guide__frame:before{left:-1px;top:-1px;border-left:2px solid;border-top:2px solid}.photo-guide__frame:after{right:-1px;bottom:-1px;border-right:2px solid;border-bottom:2px solid}.photo-guide__visual i{position:absolute;right:17px;bottom:15px;padding:6px 8px;background:#97000e;color:#fff;font-size:9px;font-style:normal;font-weight:700;letter-spacing:.08em;text-transform:uppercase}.photo-guide b{font:500 24px 'Playfair Display',serif}.photo-guide article>span{margin-top:7px;color:rgba(255,255,255,.68);font-size:13px;line-height:1.45}
  .appraisal-visual{display:grid;grid-template-columns:.72fr 1.28fr;gap:70px;align-items:center;padding:100px max(24px,calc((100vw - 1280px)/2));background:#ebe2d8}.appraisal-visual__copy h2{margin:0;font:500 clamp(42px,4.5vw,66px)/1.02 'Playfair Display',Georgia,serif;letter-spacing:-.035em}.appraisal-visual__copy>p:last-child{margin-top:24px;color:#716565;font-size:17px;line-height:1.7}.appraisal-visual img{display:block;width:100%;height:auto;border-radius:4px;box-shadow:0 22px 50px rgba(52,28,24,.15)}
  .process{display:grid;grid-template-columns:.7fr 1.3fr;gap:90px;background:var(--wine);color:#fff}.process .kicker{color:#fff}.process ol{margin:0;padding:0;list-style:none;counter-reset:step}.process li{display:grid;grid-template-columns:200px 1fr;gap:30px;padding:24px 0;border-top:1px solid rgba(255,255,255,.24)}.process li:last-child{border-bottom:1px solid rgba(255,255,255,.24)}.process li span{color:rgba(255,255,255,.78);line-height:1.55}.process--home{position:relative;background:linear-gradient(90deg,rgba(8,6,7,.92),rgba(8,6,7,.7)),url('/assets/home-process-cellar-v2.webp') center/cover}.process--home li{counter-increment:step;grid-template-columns:54px 190px 1fr;align-items:center}.process--home li:before{content:counter(step,decimal-leading-zero);color:#d71324;font:700 13px Manrope,sans-serif}.process--home ol{padding:24px 30px;background:rgba(8,6,7,.52);border:1px solid rgba(255,255,255,.16);backdrop-filter:blur(5px)}
  .trust{display:grid;grid-template-columns:1fr 1fr;gap:80px;background:#fff}.trust>div:last-child{padding-top:28px;color:#716565;font-size:18px;line-height:1.75}.trust--home{min-height:620px;align-items:center;background:linear-gradient(90deg,rgba(8,6,7,.46),rgba(8,6,7,.96) 61%),url('/assets/home-library-trust-v2.webp') center/cover;color:#fff}.trust--home>div:first-child{align-self:end;padding-bottom:28px}.trust--home>div:last-child{padding:38px;border-left:1px solid rgba(255,255,255,.2);background:rgba(8,6,7,.36);color:#d3c9c5;backdrop-filter:blur(5px)}
  @media(max-width:1000px){.clean-hero{grid-template-columns:1fr;padding-top:125px}.clean-hero--home{min-height:0}.clean-hero__visual{height:430px}.clean-hero--home .clean-hero__visual img{height:100%}.category-list{grid-template-columns:repeat(2,1fr)}.expertise,.process,.trust,.photo-guide{grid-template-columns:1fr;gap:42px}.factor-grid{grid-template-columns:1fr}.process--home li{grid-template-columns:44px 160px 1fr}.appraisal-visual{grid-template-columns:1fr;gap:36px;padding:72px 24px}}
