---
import { articles } from '../../data/articles';
import { categories, categoryBySlug } from '../../data/categories';
import { localBusinessLd, organization } from '../../data/organization';
import enhancementsCss from '../../styles/enhancements.css?raw';
import OriginalHeader from '../../components/OriginalHeader.astro';
import OriginalFooter from '../../components/OriginalFooter.astro';
import TildaChromeHead from '../../components/TildaChromeHead.astro';

export function getStaticPaths() {
  return [
    ...articles.map(article => ({ params: { slug: article.slug }, props: { article } })),
    ...categories.map(category => ({ params: { slug: category.slug }, props: { category } })),
  ];
}

const { article, category } = Astro.props;

const defaultFaq = [
  ['Можно определить точную цену только по фото?', 'По фотографиям определяется предварительный диапазон. Итог зависит от проверки подлинности и фактического состояния бутылки.'],
  ['Какие фотографии нужны?', 'Общий вид спереди и сзади, этикетки крупно, капсула и пробка, уровень напитка, дно, серийные номера и упаковка.'],
  ['Нужно ли очищать старую бутылку?', 'Нет. Не мойте этикетку и не удаляйте следы хранения: неосторожная очистка может снизить коллекционную ценность.'],
];

const articleCategory = article ? categoryBySlug.get(article.category) : undefined;
const articleNumber = article ? String(articles.findIndex(item => item.slug === article.slug) + 1).padStart(2, '0') : '';
const articleText = article ? [article.intro, ...article.sections.flatMap(section => [section.title, ...section.paragraphs]), ...article.checklist, article.note].join(' ') : '';
const readingMinutes = article ? Math.max(3, Math.ceil(articleText.split(/\s+/).length / 180)) : 0;
const sameCategory = article ? articles.filter(item => item.slug !== article.slug && item.category === article.category) : [];
const otherArticles = article ? articles.filter(item => item.slug !== article.slug && item.category !== article.category) : [];
const relatedArticles = article ? [...sameCategory, ...otherArticles].slice(0, 3) : [];
const faq = article ? (article.faq?.length ? article.faq : defaultFaq) : [];

const hubArticles = category ? articles.filter(item => item.category === category.slug) : [];
const pageTitle = article ? `${article.title} | Andrewine` : category.seoTitle;
const pageDescription = article ? article.description : category.seoDescription;
const canonical = article ? `https://andrewine.ru/articles/${article.slug}/` : `https://andrewine.ru/articles/${category.slug}/`;

const breadcrumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://andrewine.ru/' },
    { '@type': 'ListItem', position: 2, name: 'Статьи', item: 'https://andrewine.ru/articles/' },
    ...(article && articleCategory
      ? [
          { '@type': 'ListItem', position: 3, name: articleCategory.label, item: `https://andrewine.ru/articles/${articleCategory.slug}/` },
          { '@type': 'ListItem', position: 4, name: article.title, item: canonical },
        ]
      : article
        ? [{ '@type': 'ListItem', position: 3, name: article.title, item: canonical }]
        : [{ '@type': 'ListItem', position: 3, name: category.label, item: canonical }]),
  ],
};
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Andrewine" />
    <meta property="og:locale" content="ru_RU" />
    {article && <meta property="og:image" content={article.image} />}
    {article && <meta property="og:image:alt" content={article.imageAlt} />}
    <meta name="twitter:card" content={article ? 'summary_large_image' : 'summary'} />
    <meta name="geo.region" content="RU-MOW" />
    <meta name="geo.placename" content="Москва" />
    <TildaChromeHead />
    <style is:inline set:html={enhancementsCss} />
    {article && <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'Article', headline:article.title, description:article.description, image:article.image, inLanguage:'ru-RU', articleSection:articleCategory?.label ?? 'Журнал Andrewine', about:articleCategory ? { '@type':'Thing', name:articleCategory.name } : undefined, author:{ '@type':'Organization', name:organization.name, url:organization.url }, publisher:{ '@type':'Organization', name:organization.name, url:organization.url }, mainEntityOfPage:canonical })} />}
    {article && <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'FAQPage', mainEntity: faq.map(([name, text]) => ({ '@type':'Question', name, acceptedAnswer: { '@type':'Answer', text } })) })} />}
    {category && <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'CollectionPage', name: category.h1, description: category.seoDescription, url: canonical, about: { '@type':'Thing', name: category.name, description: category.definition }, keywords: category.keywords.join(', '), hasPart: hubArticles.map(item => ({ '@type':'Article', headline: item.title, url: `https://andrewine.ru/articles/${item.slug}/` })) })} />}
    {category && category.faq.length > 0 && <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'FAQPage', mainEntity: category.faq.map(([name, text]) => ({ '@type':'Question', name, acceptedAnswer: { '@type':'Answer', text } })) })} />}
    {category && <script is:inline type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'Service', name: `Оценка и выкуп: ${category.name.toLowerCase()}`, serviceType: `Скупка ${category.nameGenitive}`, description: category.seoDescription, url: canonical, provider: { '@type':'LocalBusiness', name:'Andrewine', url:'https://andrewine.ru/' }, areaServed: [{ '@type':'City', name:'Москва' }, { '@type':'Country', name:'Россия' }] })} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(breadcrumbsLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessLd())} />
  </head>
  <body class="t-body article-page">
    <div id="allrecords" class="t-records" data-tilda-project-id="22260796">
    <OriginalHeader root="../../" />
    {article ? (
    <main class="article-main">
      <section class="article-mast">
        <div class="section-rail section-rail--light" aria-hidden="true"><span>ЖУРНАЛ</span><small>ANDREWINE</small></div>
        <div class="article-cover">
          <div class="article-cover__copy">
            <a class="article-back" href={articleCategory ? `../${articleCategory.slug}/` : '../'}>← {articleCategory ? articleCategory.label : 'Все статьи'}</a>
            <div class="magazine-kicker magazine-kicker--light"><span>Журнал Andrewine</span><span>Материал {articleNumber}</span></div>
            <p class="editorial__eyebrow">{article.eyebrow}</p>
            <h1>{article.title}</h1>
            <p class="article-lead">{article.description}</p>
            <p class="article-meta">Редакция Andrewine <span aria-hidden="true">·</span> {readingMinutes} минут чтения</p>
          </div>
          <figure class="article-cover__media">
            <img src={article.image} alt={article.imageAlt} width="1200" height="800" decoding="async" fetchpriority="high" />
            <figcaption>Фото: <a href={article.imagePage} rel="noopener noreferrer">{article.imageCredit}</a></figcaption>
          </figure>
        </div>
      </section>
      <article class="article-detail">
        <aside class="article-toc" aria-label="Содержание статьи">
          <p>В материале</p>
          <ol>{article.sections.map((section, index) => <li><a href={`#section-${index + 1}`}>{section.title}</a></li>)}</ol>
        </aside>
        <div class="article-body article-body--magazine">
          <p class="article-intro">{article.intro}</p>
          {article.sections.map((section, index) => (
            <section id={`section-${index + 1}`}>
              <p class="article-section-number">{String(index + 1).padStart(2, '0')}</p>
              <h2>{section.title}</h2>
              {section.paragraphs.map(paragraph => <p>{paragraph}</p>)}
            </section>
          ))}
          <section class="article-checklist">
            <p class="editorial__eyebrow">Чек-лист</p>
            <h2>Что подготовить для оценки</h2>
            <ul>{article.checklist.map(item => <li>{item}</li>)}</ul>
          </section>
          <aside>{article.note}</aside>
        </div>
        <section class="article-faq" aria-labelledby="article-faq-title">
          <p class="editorial__eyebrow">Коротко о главном</p>
          <h2 id="article-faq-title">Частые вопросы</h2>
          <div class="article-faq__list">
            {faq.map(([q,a]) => <details class="faq__item"><summary>{q}<span>+</span></summary><p>{a}</p></details>)}
          </div>
        </section>
        {articleCategory && (
          <aside class="article-cta">
            <div>
              <p class="editorial__eyebrow">Оценка по фото</p>
              <h2>{articleCategory.buyLabel} из своей коллекции</h2>
              <p>Пришлите фотографии бутылки — специалист назовёт предварительный диапазон. Очный осмотр в Москве, работаем с регионами России.</p>
            </div>
            <div class="article-cta__links">
              <a class="article-cta__primary" href={`../../${articleCategory.buyRoute}/`}>{articleCategory.buyLabel} →</a>
              <a href={`../${articleCategory.slug}/`}>Все материалы: {articleCategory.name.toLowerCase()}</a>
            </div>
          </aside>
        )}
      </article>
      <section class="related-articles" aria-labelledby="related-title">
        <div class="related-articles__heading">
          <p class="editorial__eyebrow">Продолжить чтение</p>
          <h2 id="related-title">Другие материалы журнала</h2>
        </div>
        <div class="related-articles__grid">
          {relatedArticles.map(item => (
            <article>
              <a class="related-articles__media" href={`../${item.slug}/`}><img src={item.image} alt="" loading="lazy" decoding="async" width="600" height="450" /></a>
              <p>{item.eyebrow}</p>
              <h3><a href={`../${item.slug}/`}>{item.title}</a></h3>
            </article>
          ))}
        </div>
      </section>
    </main>
    ) : (
    <main class="article-index article-main">
      <div class="section-rail section-rail--wine" aria-hidden="true"><span>{category.name.toUpperCase()}</span><small>ANDREWINE</small></div>
      <div class="article-index__intro">
        <a class="article-back" href="../">← Все статьи</a>
        <div class="magazine-kicker"><span>Журнал Andrewine</span><span>Раздел · {category.name}</span></div>
        <h1>{category.h1}</h1>
        <p class="article-lead">{category.lead}</p>
        <nav class="category-chips" aria-label="Разделы журнала">
          {categories.map(item => (
            item.slug === category.slug
              ? <span aria-current="page">{item.name}</span>
              : <a href={`../${item.slug}/`}>{item.name}</a>
          ))}
        </nav>
      </div>
      <div class="magazine-rule"><span>{category.label}</span></div>
      <div class="editorial__grid magazine-grid">
        {hubArticles.map((item, index) => (
          <article class="article-card">
            <a class="article-card__media" href={`../${item.slug}/`} tabindex="-1" aria-hidden="true"><img src={item.image} alt="" loading="lazy" decoding="async" width="800" height="600" /></a>
            <div class="article-card__content">
              <p><span>{String(index + 1).padStart(2, '0')}</span> {item.eyebrow}</p>
              <h2><a href={`../${item.slug}/`}>{item.title}</a></h2>
              <p class="article-card__text">{item.description}</p>
              <a class="article-card__link" href={`../${item.slug}/`}>Читать статью →</a>
            </div>
          </article>
        ))}
      </div>
      {category.definition && (
      <section class="category-seo" aria-labelledby="cat-about">
        <div class="category-seo__main">
          <p class="editorial__eyebrow">Коротко</p>
          <h2 id="cat-about">Что считается коллекционным: {category.name.toLowerCase()}</h2>
          <p class="category-seo__definition">{category.definition}</p>
          {category.seoText.map(paragraph => <p>{paragraph}</p>)}
        </div>
        <aside class="category-seo__side">
          <div>
            <h3>Марки и выпуски</h3>
            <p>{category.brands.join(' · ')}</p>
          </div>
          <div>
            <h3>Что влияет на цену</h3>
            <ul>{category.priceFactors.map(factor => <li>{factor}</li>)}</ul>
          </div>
        </aside>
      </section>
      )}

      {category.faq.length > 0 && (
        <section class="category-faq" aria-labelledby="cat-faq">
          <p class="editorial__eyebrow">Частые вопросы</p>
          <h2 id="cat-faq">Что спрашивают про {category.nameAccusative}</h2>
          <div class="category-faq__list">
            {category.faq.map(([q, a]) => <details class="faq__item"><summary>{q}<span>+</span></summary><p>{a}</p></details>)}
          </div>
        </section>
      )}

      <aside class="category-cta">
        <div>
          <p class="editorial__eyebrow">Оценка по фото</p>
          <h2>Хотите продать {category.name.toLowerCase()}?</h2>
          <p>Пришлите фотографии бутылки — специалист назовёт предварительный диапазон. Принимаем в коллекцию <a href="../../premium_alcohol/">элитный алкоголь</a>, работаем с Москвой и регионами России.</p>
        </div>
        <a href={`../../${category.buyRoute}/`}>{category.buyLabel} →</a>
      </aside>
    </main>
    )}
    <OriginalFooter root="../../" />
    </div>
  </body>
</html>
