---
import { articles, articlesByCategory } from '../../data/articles';
import { categories } from '../../data/categories';
import { generalArticles } from '../../data/articles/general';
import { localBusinessLd } from '../../data/organization';
import enhancementsCss from '../../styles/enhancements.css?raw';
import OriginalHeader from '../../components/OriginalHeader.astro';
import OriginalFooter from '../../components/OriginalFooter.astro';
import TildaChromeHead from '../../components/TildaChromeHead.astro';

const featured = generalArticles[0] ?? articles[0];
const filledCategories = categories.filter(category => (articlesByCategory[category.slug] ?? []).length > 0);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Статьи об оценке и продаже коллекционного алкоголя | Andrewine</title>
    <meta name="description" content="База знаний Andrewine: как оценить и продать коллекционное вино, шампанское, виски, коньяк, портвейн, ром, водку и бренди. Оценка по фото в Москве и по России." />
    <link rel="canonical" href="https://andrewine.ru/articles/" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Статьи об оценке и продаже коллекционного алкоголя | Andrewine" />
    <meta property="og:description" content="База знаний Andrewine: оценка и продажа коллекционного алкоголя по всем категориям — от вина до бренди." />
    <meta property="og:url" content="https://andrewine.ru/articles/" />
    <meta property="og:site_name" content="Andrewine" />
    <meta property="og:locale" content="ru_RU" />
    <meta name="geo.region" content="RU-MOW" />
    <meta name="geo.placename" content="Москва" />
    <TildaChromeHead />
    <style is:inline set:html={enhancementsCss} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: 'Статьи об оценке и продаже коллекционного алкоголя',
      url: 'https://andrewine.ru/articles/',
      hasPart: categories.map(category => ({ '@type': 'CollectionPage', name: category.label, url: `https://andrewine.ru/articles/${category.slug}/` })),
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: 'https://andrewine.ru/' },
        { '@type': 'ListItem', position: 2, name: 'Статьи', item: 'https://andrewine.ru/articles/' },
      ],
    })} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(localBusinessLd())} />
  </head>
  <body class="t-body article-page">
    <div id="allrecords" class="t-records" data-tilda-project-id="22260796">
    <OriginalHeader root="../" />
    <main class="article-index article-main">
      <div class="section-rail section-rail--wine" aria-hidden="true"><span>СТАТЬИ</span><small>ANDREWINE</small></div>
      <div class="article-index__intro">
        <a class="article-back" href="../">← На главную</a>
        <div class="magazine-kicker"><span>Журнал Andrewine</span><span>База знаний</span></div>
        <h1>Истории редких бутылок и культура коллекционирования</h1>
        <p class="article-lead">Марки, винтажи, состояние и происхождение — редакционный взгляд на то, что делает бутылку коллекционной. Выберите раздел или начните с гида по съёмке.</p>
        <nav class="category-chips" aria-label="Разделы журнала">
          {categories.map(category => <a href={`./${category.slug}/`}>{category.name}</a>)}
        </nav>
      </div>
      <article class="magazine-feature">
        <a class="magazine-feature__media" href={`./${featured.slug}/`}><img src={featured.image} alt={featured.imageAlt} decoding="async" fetchpriority="high" width="1200" height="800" /></a>
        <div class="magazine-feature__copy">
          <p class="editorial__eyebrow">Материал номера · {featured.eyebrow}</p>
          <h2><a href={`./${featured.slug}/`}>{featured.title}</a></h2>
          <p>{featured.description}</p>
          <a class="article-card__link" href={`./${featured.slug}/`}>Читать материал →</a>
        </div>
      </article>
      {filledCategories.map(category => (
        <section class="category-section" aria-labelledby={`category-${category.slug}`}>
          <div class="magazine-rule"><span id={`category-${category.slug}`}>{category.label}</span><a href={`./${category.slug}/`}>Весь раздел →</a></div>
          <div class="editorial__grid magazine-grid magazine-grid--category">
            {(articlesByCategory[category.slug] ?? []).map((article, index) => (
              <article class="article-card">
                <a class="article-card__media" href={`./${article.slug}/`} tabindex="-1" aria-hidden="true"><img src={article.image} alt="" loading="lazy" decoding="async" width="800" height="600" /></a>
                <div class="article-card__content">
                  <p><span>{String(index + 1).padStart(2, '0')}</span> {article.eyebrow}</p>
                  <h2><a href={`./${article.slug}/`}>{article.title}</a></h2>
                  <p class="article-card__text">{article.description}</p>
                  <a class="article-card__link" href={`./${article.slug}/`}>Читать статью →</a>
                </div>
              </article>
            ))}
          </div>
        </section>
      ))}
    </main>
    <OriginalFooter root="../" />
    </div>
  </body>
</html>
