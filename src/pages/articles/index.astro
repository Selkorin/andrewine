---
import { articles } from '../../data/articles';
import enhancementsCss from '../../styles/enhancements.css?raw';
import { resolveVendorPaths } from '../../lib/legacyChrome';
import SiteHeader from '../../components/SiteHeader.astro';
import OriginalFooter from '../../components/OriginalFooter.astro';
import TildaChromeHead from '../../components/TildaChromeHead.astro';
import journalLibrary from '../../assets/article-journal-library.png';

const [featured, ...remainingArticles] = articles;
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Статьи об оценке коллекционного алкоголя | Andrewine</title>
    <meta name="description" content="Практические статьи об оценке коллекционного виски, коньяка, вина и шампанского: бренды, винтажи, состояние и фотографии." />
    <link rel="canonical" href="https://andrewine.ru/articles/" />
    <TildaChromeHead root="../" />
    <style is:inline set:html={resolveVendorPaths(enhancementsCss, "../")} />
  </head>
  <body class="t-body article-page">
    <div id="allrecords" class="t-records" data-tilda-project-id="22260796">
    <SiteHeader root="../" active="articles" />
    <main class="article-index article-main">
      <section class="article-index__hero" style={`--journal-library:url("${journalLibrary.src}")`}>
        <div class="article-index__frame">
          <div class="article-index__collection" aria-label="Коллекция редкого алкоголя">
            <img class="article-index__bottle article-index__bottle--macallan" src="../vendor/tilda/static.tildacdn.com/tild3461-3761-4065-b330-633464613932/__1.png" alt="The Macallan Rare Cask в подарочном футляре" width="1024" height="1536" decoding="async" fetchpriority="high" />
            <img class="article-index__bottle article-index__bottle--cristal" src="../vendor/tilda/static.tildacdn.com/tild6563-3138-4333-b162-386333396239/__1.png" alt="Louis Roederer Cristal в золотом футляре" width="1024" height="1536" decoding="async" fetchpriority="high" />
            <img class="article-index__bottle article-index__bottle--hennessy" src="../vendor/tilda/static.tildacdn.com/tild6339-6161-4239-b832-383733303766/2_1.png" alt="Hennessy XO в подарочном футляре" width="1024" height="1536" decoding="async" fetchpriority="high" />
          </div>
          <div class="section-rail section-rail--light" aria-hidden="true"><span>СТАТЬИ</span><small>ANDREWINE</small></div>
          <div class="article-index__intro">
            <a class="article-back" href="../">← На главную</a>
            <div class="magazine-kicker magazine-kicker--light"><span>Журнал Andrewine</span><span>Выпуск 01</span></div>
            <p class="article-index__folio">Архив редких бутылок · Москва</p>
            <h1>Истории редких бутылок и культура коллекционирования</h1>
            <p class="article-lead">Марки, винтажи, состояние и происхождение — редакционный взгляд на то, что делает бутылку коллекционной.</p>
          </div>
        </div>
      </section>
      <div class="article-index__content">
        <article class="magazine-feature">
        <a class="magazine-feature__media" href={`./${featured.slug}/`}><img src={resolveVendorPaths(featured.image, "../")} alt={featured.imageAlt} decoding="async" fetchpriority="high" width="1200" height="800" /></a>
        <div class="magazine-feature__copy">
          <p class="editorial__eyebrow">Материал номера · {featured.eyebrow}</p>
          <h2><a href={`./${featured.slug}/`}>{featured.title}</a></h2>
          <p>{featured.description}</p>
          <a class="article-card__link" href={`./${featured.slug}/`}>Читать материал →</a>
        </div>
        </article>
        <div class="magazine-rule"><span>Новые материалы</span></div>
        <div class="editorial__grid magazine-grid">
        {remainingArticles.map((article, index) => (
          <article class="article-card">
            <a class="article-card__media" href={`./${article.slug}/`} tabindex="-1" aria-hidden="true"><img src={resolveVendorPaths(article.image, "../")} alt="" loading="lazy" decoding="async" width="800" height="600" /></a>
            <div class="article-card__content">
              <p><span>0{index + 2}</span> {article.eyebrow}</p>
              <h2><a href={`./${article.slug}/`}>{article.title}</a></h2>
              <p class="article-card__text">{article.description}</p>
              <a class="article-card__link" href={`./${article.slug}/`}>Читать статью →</a>
            </div>
          </article>
        ))}
        </div>
      </div>
    </main>
    <OriginalFooter root="../" />
    </div>
  </body>
</html>
