    </main>

    <footer><div class="shell footer-grid"><div class="footer-brand"><div class="logo">Andrewine</div><p>Оценка и выкуп частных коллекций</p></div><nav><a href="#online-valuation">Онлайн-оценка</a><a href="#contacts">Контакты</a><button type="button" data-policy-open>Пользовательское соглашение</button><button type="button" data-privacy-open>Политика конфиденциальности</button></nav><div class="footer-contacts"><a class="track-phone" href={phoneHref}>{phone}</a><span>Москва, улица Покрышкина, 5</span><small>© 2014–2026, Andrewine</small></div></div></footer>
    <dialog class="policy" data-policy><button type="button" aria-label="Закрыть" data-policy-close>×</button><h2>Пользовательское соглашение</h2><p>Отправляя форму, вы добровольно предоставляете контактные данные для обработки обращения, подготовки оценки и обратной связи. Данные не используются для посторонних целей и передаются только специалистам Andrewine, участвующим в обработке заявки.</p></dialog>
    <dialog class="policy" data-privacy><button type="button" aria-label="Закрыть" data-privacy-close>×</button><h2>Политика конфиденциальности</h2><p>Andrewine обрабатывает имя, номер телефона, комментарий и прикреплённые фотографии только для рассмотрения заявки, предварительной оценки коллекции и обратной связи с заявителем.</p><p>Данные не публикуются и не передаются третьим лицам, за исключением случаев, предусмотренных законодательством Российской Федерации. Доступ к обращениям имеют только специалисты, участвующие в обработке заявки.</p><p>Вы можете запросить уточнение или удаление предоставленных данных, связавшись с нами по телефону {phone}. Адрес: Москва, улица Покрышкина, 5.</p></dialog>
    <CallWidget telegramHref={telegramHref} whatsappHref={whatsappHref} />

    <script>
      const goal = (name: string) => { const fn = (window as typeof window & { ym?: (...args: unknown[]) => void }).ym; if (fn) fn(113180332, 'reachGoal', name); };
      document.querySelectorAll('.track-phone').forEach((item) => item.addEventListener('click', () => goal('phone_click')));
      document.querySelectorAll('.track-tg').forEach((item) => item.addEventListener('click', () => goal('telegram_click')));
      document.querySelectorAll('.track-wa').forEach((item) => item.addEventListener('click', () => goal('whatsapp_click')));
      document.querySelectorAll('.track-max').forEach((item) => item.addEventListener('click', () => goal('max_click')));
      document.querySelectorAll<HTMLAnchorElement>('[data-call-widget] a').forEach((item) => item.addEventListener('click', () => {
        if (item.href.startsWith('tel:')) goal('phone_click');
        else if (item.href.includes('t.me/')) goal('telegram_click');
        else if (item.href.includes('wa.me/')) goal('whatsapp_click');
      }));

      const formatPhone = (input: HTMLInputElement) => {
        let digits = input.value.replace(/\D/g, '');
        if (digits.startsWith('8')) digits = `7${digits.slice(1)}`;
        if (!digits.startsWith('7')) digits = `7${digits}`;
        digits = digits.slice(0, 11); const local = digits.slice(1); let value = '+7';
        if (local.length) value += ` (${local.slice(0,3)}`; if (local.length >= 3) value += ')';
        if (local.length > 3) value += ` ${local.slice(3,6)}`; if (local.length > 6) value += `-${local.slice(6,8)}`; if (local.length > 8) value += `-${local.slice(8,10)}`;
        input.value = value;
      };
      document.querySelectorAll<HTMLInputElement>('input[type="tel"]').forEach((input) => input.addEventListener('input', () => formatPhone(input)));
      const sourceUrl = () => window.location.href;
      const send = async (data: FormData) => { const response = await fetch('/api/applications/web', { method: 'POST', body: data }); const result = await response.json().catch(() => null); if (!response.ok || !result?.uuid) throw new Error(typeof result?.detail === 'string' ? result.detail : 'Не удалось отправить заявку'); return result; };

      document.querySelectorAll<HTMLFormElement>('[data-quiz]').forEach((form) => {
        const steps = Array.from(form.querySelectorAll<HTMLElement>('[data-step]')); let current = 0;
