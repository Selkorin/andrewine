        const validate = () => { if (current < 3 && !steps[current].querySelector('input:checked')) return 'Выберите один из вариантов'; if (current === 3 && !value('name').trim()) return 'Укажите ваше имя'; if (current === 4 && value('phone').replace(/\D/g,'').length !== 11) return 'Укажите корректный номер телефона'; if (current === 5 && !files.files?.length) return 'Добавьте хотя бы одну фотографию'; if ((files.files?.length || 0) > 10) return 'Можно добавить не более 10 фотографий'; return ''; };
