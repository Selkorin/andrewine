---
import SiteHeader from '../components/SiteHeader.astro';
import CleanFooter from '../components/CleanFooter.astro';
import CleanChromeHead from '../components/CleanChromeHead.astro';
import '../styles/enhancements.css';
import YandexMetrika from '../components/YandexMetrika.astro';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex,follow" />
    <title>Страница не найдена | Andrewine</title>
    <CleanChromeHead root="./" />
  </head>
  <body class="site-body article-page">
    <YandexMetrika />
    <SiteHeader root="./" />
    <main class="not-found article-main">
      <p class="editorial__eyebrow">Ошибка 404</p>
      <h1>Такой страницы нет</h1>
      <p>Возможно, адрес изменился. Вернитесь на главную или откройте журнал Andrewine.</p>
      <div><a href="./">На главную</a><a href="./articles/">Открыть журнал</a></div>
    </main>
    <CleanFooter root="./" />
  </body>
</html>
