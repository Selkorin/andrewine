---
// Temporary preview of the Tilda-free header, so it can be reviewed on the real
// site with the real webfonts before it replaces the chrome everywhere.
// Delete this page once the header is rolled out.
import SiteHeader from '../components/SiteHeader.astro';
import enhancementsCss from '../styles/enhancements.css?raw';
import { resolveVendorPaths } from '../lib/legacyChrome';
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Превью новой шапки — Andrewine</title>
    <link rel="preconnect" href="https://fonts.gstatic.com" />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400..900&family=Manrope:wght@300;400;500;600;700&subset=latin,cyrillic" rel="stylesheet" />
    <style is:inline set:html={resolveVendorPaths(enhancementsCss, './')} />
  </head>
  <body style="margin:0;background:#f8f5ef;font-family:'Manrope',Arial,sans-serif;color:#292929;">
    <SiteHeader root="./" active="buy_cognac" />

    <main style="width:min(920px,calc(100% - 44px));margin:0 auto;padding:64px 0 120px;">
      <p style="margin:0 0 10px;color:#7e010b;font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;">Превью</p>
      <h1 style="margin:0 0 22px;font-family:'Playfair Display',Georgia,serif;font-size:clamp(34px,5vw,56px);line-height:1.04;">Шапка без Tilda</h1>
      <p style="max-width:660px;margin:0 0 16px;font-size:17px;line-height:1.66;color:#4d4845;">
        Наверху — новая шапка: своя вёрстка, без сетки t396 и без скриптов Tilda. Активный пункт подчёркнут, у «Статей» — контурная иконка книги.
      </p>
      <p style="max-width:660px;margin:0 0 16px;font-size:17px;line-height:1.66;color:#4d4845;">
        Проверьте: наведение на пункты меню, кнопку «Отправить на оценку», а на узком экране — бургер. Ширину окна можно менять прямо здесь.
      </p>
      <p style="max-width:660px;margin:0;font-size:15px;line-height:1.6;color:#6d6762;">
        Страница временная и закрыта от индексации. На остальных страницах сайта пока стоит прежняя шапка.
      </p>
    </main>
  </body>
</html>
